;;; forgejo-liens-emacs.el --- Open original Org file links -*- lexical-binding: t; -*-
;; Run: emacs --batch --quick --load scripts/forgejo-liens-emacs.el FIXTURE-DIR
(require 'org)
(require 'json)
(let ((root (file-name-as-directory (expand-file-name (pop command-line-args-left))))
      (opened 0))
  (dolist (path '("README.org" "docs/mathematiques.org" "docs/structure.org"))
    (let ((source (find-file-noselect (expand-file-name path root))))
      (with-current-buffer source
        (org-mode)
        (dolist (link (org-element-map (org-element-parse-buffer) 'link #'identity))
          (let ((target (org-element-property :path link)))
            (when (and (equal (org-element-property :type link) "file")
                       (string-suffix-p ".org" target))
              (let ((expected (expand-file-name target default-directory)))
                (unless (file-exists-p expected) (error "Missing Org file: %s" target))
                (save-window-excursion
                  (switch-to-buffer source)
                  (goto-char (org-element-property :begin link))
                  (org-open-at-point)
                  (unless (equal (file-truename buffer-file-name) (file-truename expected))
                    (error "Org opened the wrong document: %s" target)))
                (setq opened (1+ opened)))))))))
  (unless (= opened 6) (error "Expected six original Org file links, opened %s" opened))
  (princ (json-encode `((emacs . ,emacs-version) (org . ,org-version)
                        (nativeOrgFileLinksOpened . ,opened) (sourceLinksUnchanged . t))))
  (terpri))
