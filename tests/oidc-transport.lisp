(defpackage #:mrjam-oidc-transport-tests (:use #:cl) (:export #:verifier))
(in-package #:mrjam-oidc-transport-tests)

(defun verifier (fichier)
  (let* ((fixture (vision:parse-json (uiop:read-file-string fichier)))
         (curl (vision:json-object-get fixture "curl"))
         (ca (vision:json-object-get fixture "ca"))
         (secret "fixture-client-secret:+&%=")
         (nombre 0)
         (client (mrjam-oidc:faire-client-oidc "mrjam-vision" secret curl :ca ca
                   :port (vision:json-object-get fixture "port") :hotes '("vision.mrj.am"))))
    (labels ((valide (condition) (assert condition) (incf nombre))
             (refuse (fonction &optional raison)
               (valide (handler-case (progn (funcall fonction) nil)
                         (mrjam-oidc:oidc-error (c)
                           (and (not (search secret (princ-to-string c)))
                                (or (null raison) (eq raison (mrjam-oidc:oidc-error-raison c))))))))
             (post (code)
               (mrjam-oidc:echanger-code client code (make-string 43 :initial-element #\a) "vision.mrj.am"))
             (document (reponse) (mrjam-oidc:reponse-oidc-document reponse)))
      (valide (not (search secret (prin1-to-string client))))
      (dolist (cas '(("a=b&é" . "a%3Db%26%C3%A9") ("x y+z/" . "x%20y%2Bz%2F")
                    ("abc-_~." . "abc-_~.") ("" . "")))
        (valide (equal (cdr cas) (mrjam-native:parametre-url (car cas)))))
      (valide (equal "\"a\\\"b\\\\c\"" (mrjam-native:chaine-config-curl "a\"b\\c")))
      (dolist (c (list #\Newline #\Return #\Tab #\Null (code-char 127)))
        (valide (handler-case (progn (mrjam-native:chaine-config-curl (string c)) nil)
                  (mrjam-native:native-error () t))))
      (refuse (lambda () (mrjam-oidc:faire-client-oidc "mrjam-vision" secret curl :port 0 :hotes '("vision.mrj.am"))))
      (refuse (lambda () (mrjam-oidc:faire-client-oidc "mrjam-vision" secret curl :hotes '("intrus.invalid"))))
      (refuse (lambda () (mrjam-oidc:faire-client-oidc "mrjam-vision" secret curl)))
      (refuse (lambda () (mrjam-oidc::requete-oidc client "/v1/auth")))
      (refuse (lambda () (mrjam-oidc:echanger-code client "fixture" (make-string 43 :initial-element #\a) "principiipetit.io")))
      (refuse (lambda () (mrjam-oidc:echanger-code client "fixture" "verifier-court" "vision.mrj.am")))
      (valide (mrjam-oidc:verifier-discovery (mrjam-oidc:lire-discovery client) "mrjam-vision"))
      (valide (vision:json-array-p (vision:json-object-get (mrjam-oidc:lire-jwks client) "keys")))
      (let ((r (post "fixture-code")))
        (valide (= 200 (mrjam-oidc:reponse-oidc-statut r)))
        (valide (equal "fixture-access" (vision:json-object-get (document r) "access_token")))
        (valide (not (search "fixture-access" (prin1-to-string r)))))
      (let ((r (mrjam-oidc:introspecter-jeton client "fixture-access")))
        (valide (eq :true (vision:json-object-get (document r) "active"))))
      (let ((r (mrjam-oidc:introspecter-jeton client "fixture-revoque")))
        (valide (eq :false (vision:json-object-get (document r) "active"))))
      (valide (= 200 (mrjam-oidc:reponse-oidc-statut (mrjam-oidc:revoquer-jeton client "fixture-refresh"))))
      (valide (= 200 (mrjam-oidc:reponse-oidc-statut (mrjam-oidc:renouveler-jetons client "fixture-refresh"))))
      (refuse (lambda () (post "fixture-redirection")) :redirection-transport)
      (refuse (lambda () (post "fixture-json-invalide")))
      (refuse (lambda () (post "fixture-trop-long")))
      (refuse (lambda () (post "fixture-timeout")))
      (dolist (options (list (list :ca (vision:json-object-get fixture "mauvaise_ca")
                                  :port (vision:json-object-get fixture "port"))
                            (list :ca ca :port (vision:json-object-get fixture "mauvais_port"))))
        (let ((mauvais (apply #'mrjam-oidc:faire-client-oidc "mrjam-vision" secret curl
                             :hotes '("vision.mrj.am") options)))
          (refuse (lambda () (mrjam-oidc:lire-discovery mauvais)))))
      nombre)))
