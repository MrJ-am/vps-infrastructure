(defpackage #:admission-kanidm (:use #:cl) (:export #:verifier))
(in-package #:admission-kanidm)
(defun j (d k) (if (vision:json-object-p d) (vision:json-object-get d k) (cdr (assoc k d :test #'equal))))
(defun verifier (p)
  (let* ((d (vision:parse-json (uiop:read-file-string p)))
         (mrjam-identite:issuer (mrjam-oidc:issuer-client "mrjam-vision"))
         (dsn (j d "dsn")) (root (j d "root"))
         (admin (concatenate 'string dsn " user=vision_administration"))
         (admission (concatenate 'string dsn " user=vision_admission"))
         (enregistres nil)
         (client (mrjam-identite:faire-client-kanidm (j d "token") (j d "curl") (j d "ca") :port (j d "port")
                   :enregistrer (lambda (id mail) (push (cons id mail) enregistres))))
         (smtp (vision:jobject "host" "smtp.protonmail.ch" "port" 587 "username" "sender@example.test"
                  "password" "SyntheseSMTP2026Token" "from_address" "sender@example.test"
                  "starttls_required" :true "certificate_verification" :true))
         (ctx (vision-admission:faire-admission admission root smtp client))
         (inv (vision-administration:administrer admin "alice" "creer_invitation"
                  (vision:jobject "intitule" "Qualification native" "maximum" 10 "expire_a" "2026-12-31T00:00:00Z")))
         (secret (subseq (j inv "lien") (1+ (position #\# (j inv "lien")))))
         (file (vision-admission::admission-file ctx)))
    (setf (mrjam-courriel::file-transport file) (lambda (&rest args) (declare (ignore args)) t))
    (labels ((row () (vision-admission::ouvrir ctx (lambda (db) (first (mrjam-native:sqlite-requete db "SELECT * FROM demandes ORDER BY cree LIMIT 1")))))
             (confirmation (id)
               (let* ((r (mrjam-courriel::avec-file file (lambda (db) (first (mrjam-native:sqlite-requete db
                          "SELECT message FROM courriels WHERE cle=?" (list (concatenate 'string "admission:" id)))))))
                      (texte (fourth (mrjam-courriel::ancien-contenu (cdr (assoc "message" r :test #'equal)))))
                      (i (+ (search "https://vision.mrj.am/admission#" texte) (length "https://vision.mrj.am/admission#"))))
                 (subseq texte i (+ i 43)))))
      (let ((demande (vision:jobject "invitation" secret "notice" "notice-test" "courriel" "nouvelle-lisp@example.test"
                         "pays" "France" "age" "majeur" "parent" "" "pseudonyme" "Élodie 東京 avec espaces")))
        (vision-admission:demander ctx demande)
        (vision-admission:demander ctx demande)
        (vision-admission:traiter ctx)
        (assert (equal "attente" (j (row) "etat")))
        (assert (null enregistres))
        (let ((token (confirmation (j (row) "id"))))
          (vision-admission:confirmer ctx token :true)
          (assert (handler-case (progn (vision-admission:confirmer ctx token :true) nil) (vision-admission:admission-error () t))))
        (vision-admission:traiter ctx)
        (assert (equal "admise" (j (row) "etat")))
        (assert (= 1 (length enregistres)))
        (assert (equal "nouvelle-lisp@example.test" (cdar enregistres)))
        (let* ((sujet (j (row) "sujet"))
               (profil (mrjam-identite:personne client sujet))
               (compte (vision-admission::sql ctx :identifier mrjam-identite:issuer sujet)))
          (assert (equal sujet (caar enregistres)))
          (assert (eq :true (j profil "enabled")))
          (assert (eq :true (j compte "actif")))
          (assert (not (j compte "erreur"))))
        (vision-admission:traiter ctx)
        (assert (= 1 (length enregistres)))
        (assert (mrjam-courriel::avec-file file (lambda (db) (first (mrjam-native:sqlite-requete db
          "SELECT 1 FROM courriels WHERE cle=?" (list (concatenate 'string "enrol:" (j (row) "id"))))))))))
    (format t "ADMISSION-PG-NATIVE-TERMINEE")))
