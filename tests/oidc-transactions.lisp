(defpackage #:mrjam-oidc-transactions-tests (:use #:cl) (:export #:verifier))
(in-package #:mrjam-oidc-transactions-tests)

(defun verifier ()
  (let* ((racine (asdf:system-relative-pathname "mrjam-oidc" "state/"))
         (repertoire (merge-pathnames (format nil "oidc-fixture-~A/" (mrjam-native:aleatoire-hex 16)) racine))
         (chemin (merge-pathnames "transactions.sqlite" repertoire))
         (maintenant 1791777600) (nombre 0))
    (sb-posix:mkdir repertoire #o700)
    (unwind-protect
      (labels ((refuse (formulaire)
                 (incf nombre)
                 (assert (handler-case (progn (funcall formulaire) nil) (mrjam-oidc:oidc-error () t))))
               (debut (&rest options)
                 (apply #'mrjam-oidc:demarrer-transaction chemin "mrjam-vision" "vision.mrj.am" maintenant options))
               (fin (d &optional (date maintenant) (client "mrjam-vision") (hote "vision.mrj.am")
                                  (binding (mrjam-oidc:demarrage-binding d)))
                 (mrjam-oidc:consommer-transaction chemin (mrjam-oidc:demarrage-state d) binding client hote date)))
        (mrjam-oidc:initialiser-transactions chemin)
        (mrjam-oidc:initialiser-transactions chemin)
        (assert (= #o600 (logand #o777 (sb-posix:stat-mode (sb-posix:stat chemin)))))
        (let* ((classes (vision:parse-json (uiop:read-file-string
                         (asdf:system-relative-pathname "mrjam-oidc" "assemblage/oidc/tables-privees.json"))))
               (table (vision:json-object-get (vision:json-object-get classes "tables") "log_transactions"))
               (colonnes (vision:json-array-items (vision:json-object-get table "colonnes"))))
          (mrjam-native:avec-sqlite chemin
            (lambda (db)
              (let ((reelles (mapcar (lambda (ligne) (cdr (assoc "name" ligne :test #'equal)))
                                    (mrjam-native:sqlite-requete db "PRAGMA table_info(log_transactions)"))))
                (assert (equal colonnes reelles))))))
        (incf nombre 2)
        (let ((d (debut :retour "/#compte" :stepup t)))
          (assert (= 43 (length (mrjam-oidc:demarrage-state d))))
          (assert (= (+ maintenant 600) (mrjam-oidc:demarrage-expiration d)))
          (assert (not (search (mrjam-oidc:demarrage-binding d) (prin1-to-string d))))
          (refuse (lambda () (fin d maintenant "autre-client")))
          (refuse (lambda () (fin d maintenant "mrjam-vision" "matheval.mrj.am")))
          (refuse (lambda () (fin d maintenant "mrjam-vision" "vision.mrj.am" (mrjam-native:aleatoire-url))))
          ;; Une autre connexion voit la même transaction durable ; le mauvais hôte ne la consomme pas.
          (let* ((ligne (fin d)) (verifier (cdr (assoc "verifier" ligne :test #'equal))))
            (assert (= 43 (length verifier)))
            (assert (equal (mrjam-oidc:demarrage-challenge d)
                           (mrjam-native:base64 (mrjam-native::digest-octets (mrjam-native::octets verifier))
                                               :url t :sans-remplissage t)))
            (assert (equal (cdr (assoc "nonce" ligne :test #'equal)) (mrjam-oidc:demarrage-nonce d)))
            (assert (= 1 (cdr (assoc "stepup" ligne :test #'equal))))
            (assert (equal "/#compte" (cdr (assoc "retour" ligne :test #'equal))))
            (incf nombre 8))
          (refuse (lambda () (fin d))))
        (let ((d (debut)))
          (refuse (lambda () (fin d (+ maintenant 600)))))
        (dolist (retour '("//intrus.invalid" "https://intrus.invalid" "/auth/retour" "/inconnu"))
          (refuse (lambda () (debut :retour retour))))
        (refuse (lambda () (debut :retour (format nil "/oauth/authorize?~C" #\Newline))))
        (refuse (lambda () (debut :invitation (mrjam-native:aleatoire-url))))
        (refuse (lambda () (mrjam-oidc:demarrer-transaction chemin "client/injecte" "vision.mrj.am" maintenant)))
        (refuse (lambda () (mrjam-oidc:demarrer-transaction chemin "mrjam-vision" "intrus.invalid" maintenant)))
        ;; Une consommation unique sous huit connexions concurrentes, aucune réexécution d'effets.
        (let ((d (debut)) (resultats (make-array 8 :initial-element nil)) (threads '()))
          (dotimes (i 8)
            (let ((position i))
              (push (sb-thread:make-thread
                      (lambda () (setf (aref resultats position)
                                     (handler-case (progn (fin d) :consommee)
                                       (mrjam-oidc:oidc-error () :refusee))))) threads)))
          (dolist (thread threads) (sb-thread:join-thread thread))
          (assert (= 1 (count :consommee resultats)))
          (assert (= 7 (count :refusee resultats)))
          (incf nombre 8))
        ;; Les secrets de transactions d'une application n'ouvrent pas celles d'une autre.
        (let ((a (debut))
              (b (mrjam-oidc:demarrer-transaction chemin "mrjam-matheval" "matheval.mrj.am" maintenant)))
          (refuse (lambda () (mrjam-oidc:consommer-transaction chemin (mrjam-oidc:demarrage-state a)
                              (mrjam-oidc:demarrage-binding b) "mrjam-vision" "vision.mrj.am" maintenant)))
          (fin a)
          (fin b maintenant "mrjam-matheval" "matheval.mrj.am")
          (incf nombre 2))
        ;; Purge et borne contrôlées sur cette seule base synthétique.
        (mrjam-native:avec-sqlite chemin
          (lambda (db)
            (mrjam-native:sqlite-requete db "DELETE FROM log_transactions")
            (mrjam-native:sqlite-requete db
              "WITH RECURSIVE n(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<4096)
               INSERT INTO log_transactions
               SELECT 'fixture-'||x,'binding','client','vision.mrj.am','verifier','nonce','/',?,0,NULL,NULL FROM n"
              (list (+ maintenant 600)))))
        (refuse (lambda () (debut)))
        (let ((d (mrjam-oidc:demarrer-transaction chemin "mrjam-vision" "vision.mrj.am" (+ maintenant 600))))
          (assert (fin d (+ maintenant 600))) (incf nombre))
        (format t "~&OIDC transactions : ~D contrôles terminés, SQLite privé et consommation concurrente unique.~%" nombre)
        t)
      (when (probe-file chemin) (delete-file chemin))
      (sb-posix:rmdir repertoire))))
