;;; Parcours intégré sur Kanidm officiel + PostgreSQL isolés. Aucune donnée réelle.
(defpackage #:mrjam-audition-oidc-tests (:use #:cl))
(in-package #:mrjam-audition-oidc-tests)
(defvar *c* nil)
(defvar *service* nil)
(defvar *prive* nil)
(defvar *assertions* 0)
(defvar *actif* t)
(defun j (o k) (vision:json-object-get o k))
(defun o (&rest p) (apply #'vision:jobject p))
(defun oui (p) (unless p (error "Assertion publique ~D" (1+ *assertions*))) (incf *assertions*))
(defun refus (f)
  (oui (handler-case (progn (funcall f) nil)
         (mrjam-log:log-error () t) (mrjam-oidc:oidc-error () t))))
(defun cle () (mrjam-native:aleatoire-url))
(defun lire () (vision:parse-json (uiop:read-file-string (uiop:getenv "MRJAM_AUDITION_OIDC_FIXTURE"))))
(defun memoriser (k v) (setf *prive* (mrjam-audition::remplacer *prive* k v)) v)
(defun sauver ()
  (let ((p (j (lire) "resultat")))
    (with-open-file (s p :direction :output :if-exists :supersede :if-does-not-exist :error)
      (write-string (vision:json-encode (mrjam-audition::remplacer *prive* "assertions" *assertions*)) s))))
(defun initialiser ()
  (let* ((d (lire))
         (client (mrjam-oidc:faire-client-oidc "mrjam-vision" (j d "secret") (j d "curl")
                   :ca (j d "ca") :port (j d "port") :hotes '("vision.mrj.am" "audition.mrj.am"))))
    (setf *prive* (vision:parse-json (uiop:read-file-string (j d "resultat")))
          *assertions* (or (j *prive* "assertions") 0)
          *service* (mrjam-audition:faire-service (j d "dsn"))
          *c* (mrjam-log::initialiser-oauth (mrjam-log:initialiser
            (mrjam-log:faire-contexte (j d "base")
              (list (cons "vision.mrj.am" client) (cons "audition.mrj.am" client))
              (lambda (issuer sub)
                (oui (equal issuer (mrjam-oidc:issuer-client "mrjam-vision")))
                (let ((acteur (cond ((equal sub (j d "prof_uuid")) "alice")
                                   ((equal sub (j d "eleve_uuid")) "bob"))))
                  (unless acteur (error "Sujet synthétique inconnu"))
                  (o "actif" (if *actif* :true :false) "utilisateur" acteur)))))))
    (mrjam-log::base *c* (lambda (db)
      (mrjam-native:sqlite-requete db "INSERT OR IGNORE INTO log_principaux VALUES(?,?,?,?,?)"
        (list (j d "prof_uuid") "prof@example.test" 604800 "mfa" (- (mrjam-log::temps) 10)))))))
(defun debut ()
  (let ((d (lire)))
    (multiple-value-bind (uri cookie) (mrjam-log:demarrer *c* (j d "hote") (j d "retour"))
      (memoriser "uri" uri) (memoriser "transaction" cookie))))
(defun retour ()
  (let* ((d (lire)) (hote (j d "hote")))
    (multiple-value-bind (retour cookie efface)
        (mrjam-log:retour *c* hote (j d "state") (j d "code") (j *prive* "transaction"))
      (oui (equal retour (j d "retour"))) (oui (search "Max-Age=0" efface))
      (oui (and (search "Secure; HttpOnly; SameSite=Lax" cookie) (not (search "Domain=" cookie))))
      (memoriser (j d "nom_session") cookie)
      (oui (equal (j d "acteur") (mrjam-log::champ (mrjam-log:session *c* hote cookie) "username")))
      (oui (null (mrjam-log:session *c* (if (equal hote "vision.mrj.am") "audition.mrj.am" "vision.mrj.am") cookie))))
    (refus (lambda () (mrjam-log:retour *c* hote (j d "state") (j d "code") (j *prive* "transaction"))))))
(defun route (chemin corps &key (cookie (j *prive* "prof_cookie")) bearer (csrf t) (origin "https://audition.mrj.am"))
  (let* ((d (lire)) (sortie (j d "http"))
         (headers (append '(("x-forwarded-host" . "audition.mrj.am") ("x-forwarded-proto" . "https")
                            ("content-type" . "application/json"))
                    (when cookie (list (cons "cookie" cookie)))
                    (when bearer (list (cons "authorization" (concatenate 'string "Bearer " bearer))))
                    (when origin (list (cons "origin" origin)))
                    (when (and csrf cookie)
                      (list (cons "x-csrf-token" (mrjam-log::champ (mrjam-log:session *c* "audition.mrj.am" cookie) "csrf")))))))
    (handler-case
      (progn
        (with-open-file (s sortie :direction :output :element-type '(unsigned-byte 8)
                           :if-exists :supersede :if-does-not-exist :create)
          (mrjam-metier::router-audition *service* *c* s "POST" chemin headers (vision:json-encode corps)))
        (let* ((s (uiop:read-file-string sortie)) (separateur (format nil "~C~C~C~C" #\Return #\Newline #\Return #\Newline))
               (p (search separateur s)))
          (unless p (error "Réponse HTTP de fixture incomplète"))
          (values (parse-integer s :start 9 :end 12) (vision:parse-json (subseq s (+ p 4))))))
      (mrjam-metier:http-error (e) (values (mrjam-metier:http-status e) nil)))))
(defun web (nom p)
  (multiple-value-bind (status doc) (route (concatenate 'string "/api/audition/" nom) p)
    (oui (= status 200)) doc))
(defun mcp (nom p &optional (attendu nil))
  (multiple-value-bind (status doc)
      (route "/mcp" (o "jsonrpc" "2.0" "id" 1 "method" "tools/call" "params" (o "name" nom "arguments" p))
             :cookie nil :bearer (j *prive* "eleve_access") :origin nil)
    (oui (= status 200))
    (let* ((r (j doc "result")) (s (j r "structuredContent")))
      (oui (eq (j r "isError") (if attendu :true :false)))
      (when attendu (oui (equal attendu (j s "erreur")))) s)))
(defun habiliter (g acteur role)
  (web "habiliter" (o "groupe" g "acteur" acteur "role" role "cle" (cle))))
(defun preparer ()
  (let ((s (mrjam-log:session *c* "audition.mrj.am" (j *prive* "prof_cookie"))))
    (oui (mrjam-log::verification-renforcee-p *c* s))
    (oui (not (mrjam-log::verification-renforcee-p *c* s (+ (mrjam-log::champ s "auth_time") 901)))))
  (multiple-value-bind (status doc) (route "/api/audition/contexte" (o) :csrf nil)
    (declare (ignore doc)) (oui (= status 403)))
  (multiple-value-bind (status doc) (route "/api/audition/contexte" (o) :origin "https://vision.mrj.am")
    (declare (ignore doc)) (oui (= status 403)))
  (multiple-value-bind (status doc) (route "/api/audition/contexte" (o) :cookie (j *prive* "vision_cookie") :csrf nil)
    (declare (ignore doc)) (oui (= status 401)))
  (multiple-value-bind (status doc) (route "/mcp" (o) :bearer nil :csrf nil)
    (declare (ignore doc)) (oui (= status 401)))
  (let* ((g (j (web "creer_groupe" (o "nom" "Classe synthétique MFA" "cle" (cle))) "id"))
         (autre (j (web "creer_groupe" (o "nom" "Autre classe isolée" "cle" (cle))) "id")))
    (memoriser "groupe" g) (memoriser "autre_groupe" autre)
    (habiliter g "alice" "enseignant") (habiliter g "bob" "eleve")
    (let* ((cours (web "cours" (o "groupe" g "document" (o "titre" "Le signe d'un carré" "contenu" "Le produit de deux réels de même signe est positif.") "cle" (cle))))
           (a (web "activite" (o "groupe" g "cle" (cle) "document"
                (o "titre" "Justifier un signe" "cours" (j cours "id") "type" "ouverte" "consigne" "Justifier x² ≥ 0, y compris zéro."
                   "corrige" "CORRIGE_RESTE_COTE_ENSEIGNANT"
                   "attendus" (vision:jarray (o "id" "raisonner" "texte" "Justifier le signe d'un carré"))
                   "criteres" (vision:jarray (o "id" "signe" "attendu" "raisonner" "texte" "Les deux signes et zéro" "maximum" 2))))))
           (aff (web "affecter" (o "groupe" g "activite" (j a "id") "eleves" (vision:jarray "bob")
                                  "echeance" (+ (mrjam-log::temps) 86400) "cle" (cle)))))
      (memoriser "activite" (j a "id")) (memoriser "affectation" (j aff "id")))))
(defun jetons (hote cookie)
  (let* ((mrjam-log::*hote-mcp* hote) (v (cle))
         (client (mrjam-log::enregistrer-client *c* (o "client_name" "Fixture pédagogique" "redirect_uris" (vision:jarray "https://client.example.test/retour"))))
         (id (j client "client_id"))
         (query (o "client_id" id "redirect_uri" "https://client.example.test/retour" "response_type" "code"
                   "state" "fixture-mcp" "code_challenge_method" "S256" "scope" (mrjam-log::scope-mcp)
                   "resource" (mrjam-log::url-mcp)
                   "code_challenge" (mrjam-native:base64 (mrjam-native::digest-octets (mrjam-native::octets v)) :url t :sans-remplissage t))))
    (oui (equal (mrjam-log::url-mcp) (j (mrjam-log::metadata-mcp t) "resource")))
    (refus (lambda () (mrjam-log::demander-mcp *c* cookie (mrjam-audition::remplacer query "resource" "https://externe.example.test/mcp"))))
    (refus (lambda () (mrjam-log::demander-mcp *c* cookie (mrjam-audition::remplacer query "scope" "role:enseignant"))))
    (let* ((demande (mrjam-log::demander-mcp *c* cookie query))
           (autre (if (equal hote "vision.mrj.am") "audition.mrj.am" "vision.mrj.am")))
      (oui (equal (mrjam-log::scope-mcp) (j (mrjam-log::lire-demande-mcp *c* cookie demande) "scope")))
      (let ((mrjam-log::*hote-mcp* autre))
        (refus (lambda () (mrjam-log::consentir-mcp *c* cookie demande t))))
      (refus (lambda () (mrjam-log::lire-demande-mcp *c* (mrjam-log:cookie-session (cle)) demande)))
      (let* ((uri (mrjam-log::consentir-mcp *c* cookie demande t))
             (params (mrjam-metier::decode-query (subseq uri (1+ (position #\? uri)))))
             (q (o "grant_type" "authorization_code" "client_id" id "code" (j params "code")
                   "redirect_uri" "https://client.example.test/retour" "code_verifier" v)))
        (oui (equal "fixture-mcp" (j params "state")))
        (let ((mrjam-log::*hote-mcp* autre)) (refus (lambda () (mrjam-log::jetons-mcp *c* q))))
        (refus (lambda () (mrjam-log::jetons-mcp *c* (mrjam-audition::remplacer q "code_verifier" (cle)))))
        (let* ((tokens (mrjam-log::jetons-mcp *c* q))
               (refresh (o "grant_type" "refresh_token" "client_id" id "refresh_token" (j tokens "refresh_token"))))
          (oui (equal (mrjam-log::scope-mcp) (j tokens "scope")))
          (refus (lambda () (mrjam-log::jetons-mcp *c* q)))
          (let ((mrjam-log::*hote-mcp* autre))
            (oui (null (mrjam-log::verifier-mcp *c* (concatenate 'string "Bearer " (j tokens "access_token")))))
            (refus (lambda () (mrjam-log::jetons-mcp *c* refresh))))
          (let ((new (mrjam-log::jetons-mcp *c* refresh)))
            (oui (not (equal (j tokens "refresh_token") (j new "refresh_token"))))
            (values new id refresh)))))))
(defun seance ()
  (multiple-value-bind (tokens id ancien) (jetons "vision.mrj.am" (j *prive* "vision_cookie"))
    (declare (ignore id ancien))
    (multiple-value-bind (status doc) (route "/mcp" (o) :cookie nil :bearer (j tokens "access_token") :origin nil)
      (declare (ignore doc)) (oui (= status 401))))
  (multiple-value-bind (tokens id ancien) (jetons "audition.mrj.am" (j *prive* "eleve_cookie"))
    (memoriser "eleve_access" (j tokens "access_token")) (memoriser "eleve_refresh" (j tokens "refresh_token"))
    (memoriser "client" id) (memoriser "ancien_refresh" ancien))
  (multiple-value-bind (status doc)
      (route "/mcp" (o "jsonrpc" "2.0" "id" 2 "method" "tools/call" "params"
                        (o "name" "creer_groupe" "arguments" (o "nom" "Refus attendu" "cle" (cle))))
             :cookie nil :bearer (j *prive* "eleve_access") :origin nil)
    (oui (= status 403)) (oui (equal "verification_renforcee_requise" (j doc "erreur"))))
  (let* ((g (j *prive* "groupe"))
         (p (o "groupe" g "affectation" (j *prive* "affectation") "cle" (cle)))
         (r (mcp "ouvrir_seance" p)) (s (j r "seance")) (id (j s "id"))
         (instant (mrjam-log::temps)))
    (oui (not (search "CORRIGE_RESTE_COTE_ENSEIGNANT" (vision:json-encode r))))
    (oui (equal id (j (j (mcp "ouvrir_seance" p) "seance") "id")))
    (mcp "rapport" (o "groupe" g) "groupe_interdit")
    (mcp "travaux" (o "groupe" (j *prive* "autre_groupe")) "groupe_interdit")
    (mcp "contexte" (o "role" "enseignant") "champs_invalides")
    (mcp "transition" (o "groupe" g "id" id "revision" 1 "action" "terminer" "cle" (cle)) "seance_incomplete")
    (let* ((p (o "groupe" g "id" id "revision" 1 "activite_version" 1 "politique_version" 1
                 "production" "Si x est négatif les deux facteurs le sont ; leur produit est positif. Si x = 0 le carré vaut zéro."
                 "activite_a" instant "cle" (cle)
                 "aides" (vision:jarray (o "nature" "indice" "contenu" "Pense aussi au cas zéro." "activite_a" instant))
                 "observations" (vision:jarray (o "critere" "signe" "etat" "reussite_aidee" "points" 2 "justification" "Les signes et zéro sont traités après un indice."))))
           (obs (mcp "consigner" p)) (rejeu (mcp "consigner" p)))
      (oui (= (j (j obs "seance") "revision") (j (j rejeu "seance") "revision")))
      (let ((fin (mcp "transition" (o "groupe" g "id" id "revision" 2 "action" "terminer" "cle" (cle)))))
        (oui (equal "terminee" (j (j (j fin "seance") "document") "etat")))))
    (memoriser "seance" id)
    (let* ((rapport (web "rapport" (o "groupe" g))) (ligne (first (vision:json-array-items (j rapport "elements")))))
      (oui (= 1 (j rapport "total")))
      (oui (search "reussite_aidee" (vision:json-encode ligne)))
      (oui (equal "bob" (j ligne "eleve"))))))
(defun reprendre ()
  (oui (equal "alice" (mrjam-log::champ (mrjam-log:session *c* "audition.mrj.am" (j *prive* "prof_cookie")) "username")))
  (oui (equal "bob" (mrjam-log::champ (mrjam-log:session *c* "audition.mrj.am" (j *prive* "eleve_cookie")) "username")))
  (let* ((r (mcp "consulter_seance" (o "groupe" (j *prive* "groupe") "id" (j *prive* "seance"))))
         (s (j (j r "seance") "document")))
    (oui (equal "terminee" (j s "etat")))
    (oui (= 1 (length (vision:json-array-items (j s "tentatives"))))))
  (oui (= 1 (j (web "rapport" (o "groupe" (j *prive* "groupe"))) "total")))
  (let* ((mrjam-log::*hote-mcp* "audition.mrj.am") (auth (concatenate 'string "Bearer " (j *prive* "eleve_access"))))
    (oui (equal "bob" (mrjam-log::verifier-mcp *c* auth)))
    (oui (null (mrjam-log::verifier-mcp *c* auth (+ (mrjam-log::temps) (* 31 86400)))))
    (setf *actif* nil)
    (refus (lambda () (mrjam-log::verifier-mcp *c* auth)))
    (setf *actif* t)
    ;; La réutilisation d'un refresh consommé révoque réellement toute sa famille.
    (refus (lambda () (mrjam-log::jetons-mcp *c* (j *prive* "ancien_refresh"))))
    (oui (null (mrjam-log::verifier-mcp *c* auth)))
    (multiple-value-bind (tokens id ancien) (jetons "audition.mrj.am" (j *prive* "eleve_cookie"))
      (declare (ignore ancien))
      (let ((bearer (concatenate 'string "Bearer " (j tokens "access_token"))))
        (oui (equal "bob" (mrjam-log::verifier-mcp *c* bearer)))
        (mrjam-log::revoquer-mcp *c* id (j tokens "refresh_token"))
        (oui (null (mrjam-log::verifier-mcp *c* bearer)))))
    (multiple-value-bind (tokens id ancien) (jetons "audition.mrj.am" (j *prive* "eleve_cookie"))
      (declare (ignore id ancien))
      (mrjam-log:deconnecter *c* "audition.mrj.am" (j *prive* "eleve_cookie"))
      (oui (null (mrjam-log::verifier-mcp *c* (concatenate 'string "Bearer " (j tokens "access_token")))))))
  (oui (mrjam-log:session *c* "vision.mrj.am" (j *prive* "vision_cookie")))
  (oui (mrjam-log:session *c* "audition.mrj.am" (j *prive* "prof_cookie"))))
