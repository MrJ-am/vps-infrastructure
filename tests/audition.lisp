(defpackage #:mrjam-audition-tests (:use #:cl) (:export #:verifier))
(in-package #:mrjam-audition-tests)

(defvar *assertions* 0)
(defun oui (p) (assert p () "Assertion Audition numéro ~D échouée." (1+ *assertions*)) (incf *assertions*))
(defun non (code f)
  (oui (handler-case (progn (funcall f) nil)
         (mrjam-audition:audition-error (e) (equal code (mrjam-audition:code-erreur e))))))
(defun j (o k) (vision:json-object-get o k))
(defun o (&rest p) (apply #'vision:jobject p))
(defun cle () (mrjam-native:aleatoire-url))
(defun activite (&optional (consigne "Justifier x² ≥ 0 pour un réel x."))
  (o "titre" "Carré d'un réel" "consigne" consigne "type" "ouverte" "corrige" "CORRIGE_PRIVE"
     "attendus" (vision:jarray (o "id" "raisonner" "texte" "Justifier le signe d'un carré"))
     "criteres" (vision:jarray (o "id" "signe" "attendu" "raisonner" "texte" "Traiter les deux signes de x" "maximum" 2))))
(defun verifier ()
  (setf *assertions* 0)
  (oui (mrjam-audition::acteur-p "alice.2"))
  (oui (not (mrjam-audition::acteur-p "alice/2")))
  (oui (vision:parse-json (vision:json-encode (mrjam-audition:indicateur 1 3 :propositions 3))))
  (oui (< (abs (mrjam-audition:logit-db 1/4 1/4)) 1d-10))
  (oui (< (abs (- (mrjam-audition:logit-db 1/2 1/4) (* 10 (log 3d0 10d0)))) 1d-10))
  (oui (eq :absent (mrjam-audition:logit-db nil)))
  (oui (eq :moins-infini (mrjam-audition:logit-db 0)))
  (oui (eq :plus-infini (mrjam-audition:logit-db 1)))
  (oui (equal "12:1 dB" (mrjam-audition:afficher-db (+ 12d0 (/ 0.01d0 (/ (log 10d0) 10d0))))))
  (oui (equal "12:-1 dB" (mrjam-audition:afficher-db (- 12d0 (/ 0.01d0 (/ (log 10d0) 10d0))))))
  (oui (equal "12 dB" (mrjam-audition:afficher-db 12d0)))
  (oui (eq :null (j (mrjam-audition:indicateur 0 0) "proportion")))
  (oui (eq :null (j (mrjam-audition:indicateur 1 2) "reference_hasard")))
  (oui (= 1/4 (j (mrjam-audition:indicateur 1 2 :propositions 4) "reference_hasard")))
  (non "proportion_invalide" (lambda () (mrjam-audition:logit-db 2)))
  (non "proportion_invalide" (lambda () (mrjam-audition:logit-db 1/2 0)))
  (non "effectif_invalide" (lambda () (mrjam-audition:indicateur 2 1)))
  (oui (not (j (mrjam-audition::activite-visible (activite) nil 1) "corrige")))
  (oui (equal "CORRIGE_PRIVE" (j (mrjam-audition::activite-visible (activite) t 1) "corrige")))
  (non "champs_invalides" (lambda () (mrjam-audition::valider-activite (mrjam-audition::remplacer (activite) "role" "enseignant"))))
  (non "autonomie_incompatible_avec_aide" (lambda ()
    (mrjam-audition::observer (o "critere" "signe" "etat" "reussite_autonome" "points" 2 "justification" "Trace") (activite) '(t) 1)))
  (non "reussite_incomplete" (lambda ()
    (mrjam-audition::observer (o "critere" "signe" "etat" "reussite_autonome" "points" 1 "justification" "Trace") (activite) nil 1)))
  (non "aide_manquante" (lambda ()
    (mrjam-audition::observer (o "critere" "signe" "etat" "reussite_aidee" "points" 2 "justification" "Trace") (activite) nil 1)))
  (let ((dsn (uiop:getenv "AUDITION_TEST_DSN")))
    (unless dsn (error "Qualification métier : base isolée requise."))
    (let* ((s (mrjam-audition:faire-service dsn)) (temps 1780000000) (g nil) (a nil) (aff nil) (seance nil))
      (setf (mrjam-audition::service-horloge s) (lambda () temps))
      (flet ((app (acteur nom p) (mrjam-audition:appeler s acteur nom p))
             (echec (acteur nom p code) (non code (lambda () (mrjam-audition:appeler s acteur nom p)))))
        (echec "eleve" "creer_groupe" (o "nom" "Classe" "cle" (cle)) "administration_interdite")
        (setf g (j (app "admin" "creer_groupe" (o "nom" "Classe isolée" "cle" (cle))) "id"))
        (dolist (p '(("prof" "enseignant") ("eleve" "eleve") ("voisin" "eleve")))
          (app "admin" "habiliter" (o "groupe" g "acteur" (first p) "role" (second p) "cle" (cle))))
        (oui (= 1 (j (app "eleve" "contexte" (o)) "total")))
        (echec "admin" "rapport" (o "groupe" g) "groupe_interdit")
        (echec "intrus" "rapport" (o "groupe" g) "groupe_interdit")
        (echec "eleve" "activite" (o "groupe" g "document" (activite) "cle" (cle)) "groupe_interdit")
        (echec "eleve" "contexte" (o "role" "enseignant") "champs_invalides")
        (let* ((key (cle)) (p (o "groupe" g "document" (activite) "cle" key)) (r (app "prof" "activite" p)))
          (setf a (j r "id"))
          (oui (equal a (j (app "prof" "activite" p) "id")))
          (echec "prof" "activite" (o "groupe" g "document" (activite "Autre consigne") "cle" key) "cle_reutilisee_avec_autre_operation"))
        (setf aff (j (app "prof" "affecter" (o "groupe" g "activite" a "eleves" (vision:jarray "eleve") "echeance" (+ temps 86400) "cle" (cle))) "id"))
        (let* ((propose (o "groupe" g "document" (activite "PROPOSITION_NON_OFFICIELLE") "cle" (cle)))
               (proposition (mrjam-audition:appeler s "prof" "activite" propose :canal "mcp"))
               (id (j proposition "id")))
          (non "cle_reutilisee_avec_autre_operation" (lambda () (mrjam-audition:appeler s "prof" "activite" propose :canal "web")))
          (oui (eq :false (j (j proposition "document") "validee")))
          (echec "prof" "affecter" (o "groupe" g "activite" id "eleves" (vision:jarray "eleve") "echeance" temps "cle" (cle)) "proposition_non_validee")
          (oui (eq :true (j (j (app "prof" "activite" (o "groupe" g "id" id "revision" 1 "document" (activite "Proposition relue et validée par l'enseignant") "cle" (cle))) "document") "validee"))))
        (oui (not (search "CORRIGE_PRIVE" (vision:json-encode (app "eleve" "travaux" (o "groupe" g))))))
        (oui (= 0 (j (app "voisin" "travaux" (o "groupe" g)) "total")))
        (oui (equal "non_observe" (j (first (vision:json-array-items (j (app "prof" "rapport" (o "groupe" g)) "elements"))) "etat")))
        (echec "voisin" "ouvrir_seance" (o "groupe" g "affectation" aff "cle" (cle)) "objet_indisponible")
        (let* ((p (o "groupe" g "affectation" aff "cle" (cle))) (r (app "eleve" "ouvrir_seance" p)))
          (setf seance (j (j r "seance") "id"))
          (oui (equal seance (j (j (app "eleve" "ouvrir_seance" p) "seance") "id")))
          (oui (equal seance (j (j (app "eleve" "ouvrir_seance" (o "groupe" g "affectation" aff "cle" (cle))) "seance") "id"))))
        (echec "voisin" "consulter_seance" (o "groupe" g "id" seance) "objet_indisponible")
        (echec "eleve" "transition" (o "groupe" g "id" seance "revision" 1 "action" "terminer" "cle" (cle)) "seance_incomplete")
        (echec "eleve" "transition" (o "groupe" g "id" seance "revision" 1 "action" "reprendre" "cle" (cle)) "transition_interdite")
        (labels ((tentative (rev av key &optional aide)
          (o "groupe" g "id" seance "revision" rev "activite_version" av "politique_version" 1
            "production" "Le produit de deux réels de même signe est positif, zéro inclus."
            "activite_a" temps "aides" (if aide (vision:jarray (o "nature" "indice" "contenu" "Distinguer les signes." "activite_a" temps)) (vision:jarray))
            "observations" (vision:jarray (o "critere" "signe" "etat" (if aide "reussite_aidee" "reussite_autonome") "points" 2 "justification" "Les deux cas de signe sont explicitement traités.")) "cle" key)))
          (let* ((p (tentative 1 1 (cle) t)) (r (app "eleve" "consigner" p)))
            (oui (= 2 (j (j r "seance") "revision")))
            ;; Réponse perdue après COMMIT : même opération, même clé, aucune
            ;; nouvelle tentative ; constat réel par une nouvelle connexion.
            (oui (equal (vision:json-encode (mrjam-audition::canonique r))
                        (vision:json-encode (mrjam-audition::canonique (app "eleve" "consigner" p)))))
            (oui (= 1 (j (j (app "eleve" "consulter_seance" (o "groupe" g "id" seance)) "traces") "total")))
            (echec "eleve" "consigner" (tentative 1 1 (cle)) "conflit_revision"))
          (app "prof" "activite" (o "groupe" g "id" a "revision" 1 "document" (activite "Justifier aussi le cas nul.") "cle" (cle)))
          (oui (eq :true (j (app "eleve" "consulter_seance" (o "groupe" g "id" seance)) "contexte_modifie")))
          (echec "eleve" "consigner" (tentative 2 1 (cle)) "contexte_modifie")
          (echec "eleve" "adopter_contexte" (o "groupe" g "id" seance "revision" 2 "activite_version" 1 "cle" (cle)) "contexte_modifie")
          (app "eleve" "adopter_contexte" (o "groupe" g "id" seance "revision" 2 "activite_version" 2 "cle" (cle)))
          (echec "eleve" "transition" (o "groupe" g "id" seance "revision" 3 "action" "terminer" "cle" (cle)) "criteres_non_observes")
          (app "eleve" "transition" (o "groupe" g "id" seance "revision" 3 "action" "interrompre" "cle" (cle)))
          (echec "eleve" "consigner" (tentative 4 2 (cle)) "seance_non_ouverte")
          (incf temps 3600)
          (app "eleve" "transition" (o "groupe" g "id" seance "revision" 4 "action" "reprendre" "cle" (cle)))
          (echec "eleve" "consigner" (mrjam-audition::remplacer (tentative 5 2 (cle)) "activite_a" (+ temps 1000)) "heure_activite_invalide")
          (let* ((p1 (tentative 5 2 (cle))) (p2 (tentative 5 2 (cle))) (resultats (make-array 2)))
            (let ((threads (loop for p in (list p1 p2) for n from 0 collect
              (let ((params p) (index n)) (sb-thread:make-thread (lambda ()
                (setf (aref resultats index) (handler-case (progn (app "eleve" "consigner" params) "ok")
                  (mrjam-audition:audition-error (e) (mrjam-audition:code-erreur e))))))))))
              (mapc #'sb-thread:join-thread threads))
            (oui (= 1 (count "ok" resultats :test #'equal)))
            (oui (= 1 (count "conflit_revision" resultats :test #'equal))))
          (let* ((r (app "eleve" "consulter_seance" (o "groupe" g "id" seance)))
                 (tent (first (vision:json-array-items (j (j r "traces") "elements")))))
            (oui (= 2 (j (j r "traces") "total")))
            (oui (< (j tent "recu_a") temps))
            (app "prof" "rectifier" (o "groupe" g "id" seance "revision" 6 "tentative" (j tent "id") "observation" "signe"
               "etat" "difficulte" "points" 0 "justification" "La production initiale ne traitait pas explicitement zéro." "cle" (cle)))
            (oui (= 1 (length (vision:json-array-items (j (j (j (app "prof" "consulter_seance" (o "groupe" g "id" seance)) "seance") "document") "rectifications")))))
            (oui (= 2 (j (j (app "prof" "consulter_seance" (o "groupe" g "id" seance)) "traces") "total"))))
          (app "eleve" "transition" (o "groupe" g "id" seance "revision" 7 "action" "terminer" "cle" (cle)))
          (echec "eleve" "consigner" (tentative 8 2 (cle)) "seance_non_ouverte")
          (let ((rapport (app "prof" "rapport" (o "groupe" g))))
            (oui (= 1 (j rapport "total")))
            (oui (search "reussite_autonome" (vision:json-encode rapport))))
          (app "prof" "remediation" (o "groupe" g "activite" a "eleves" (vision:jarray "eleve") "origine" seance
            "consigne" "Examiner x=0 puis les deux signes." "echeance" (+ temps 86400) "cle" (cle)))
          (oui (= 2 (j (app "eleve" "travaux" (o "groupe" g)) "total")))
          (multiple-value-bind (status raison corps)
             (mrjam-audition:mcp s "eleve" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}")
            (declare (ignore raison)) (oui (= 200 status)) (oui (equal "audition" (j (j (j (vision:parse-json corps) "result") "serverInfo") "name"))))
          (multiple-value-bind (status raison corps)
             (mrjam-audition:mcp s "eleve" "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"consigner\",\"arguments\":{}}}")
            (declare (ignore raison)) (oui (= 202 status)) (oui (null corps)))
          (oui (= 20 (length (vision:json-array-items (mrjam-audition:catalogue-mcp)))))
          ;; Révocation avant rejeu : aucun rapport pédagogique restitué.
          (let ((p (o "groupe" g "id" seance "revision" 8 "action" "interrompre" "cle" (cle))))
            (app "admin" "habiliter" (o "groupe" g "acteur" "eleve" "role" "retirer" "cle" (cle)))
            (echec "eleve" "transition" p "groupe_interdit"))
          (let* ((supprimable (j (app "admin" "creer_groupe" (o "nom" "Suppression isolée" "cle" (cle))) "id")))
            (app "admin" "habiliter" (o "groupe" supprimable "acteur" "admin" "role" "enseignant" "cle" (cle)))
            (app "admin" "cours" (o "groupe" supprimable "document" (o "titre" "Contenu à supprimer" "contenu" "Trace de fixture") "cle" (cle)))
          (echec "admin" "supprimer_groupe" (o "groupe" supprimable "confirmation" "autre" "cle" (cle)) "confirmation_requise")
          (let ((p (o "groupe" supprimable "confirmation" supprimable "cle" (cle))))
            (oui (eq :true (j (app "admin" "supprimer_groupe" p) "supprime")))
            (oui (eq :true (j (app "admin" "supprimer_groupe" p) "supprime")))
            (oui (= 1 (j (app "prof" "contexte" (o)) "total")))))))))
  (format t "~&Audition : ~D assertions métier, calculs, droits, reprise, versions, concurrence et MCP réussies.~%" *assertions*)
  t)
