(defpackage #:mrjam-log-kanidm-tests
  (:use #:cl) (:export #:preparer #:terminer #:reprendre #:logout #:preparer-bob #:terminer-bob))
(in-package #:mrjam-log-kanidm-tests)
(defvar *contexte* nil)
(defvar *cookie* nil)
(defvar *actif* t)
(defun lire (p) (vision:parse-json (uiop:read-file-string p)))
(defun j (o k) (vision:json-object-get o k))
(defun sauvegarder (p doc)
  ;; Fichier déjà créé0600 par Python : overwrite conserve ses permissions.
  (with-open-file (s p :direction :output :if-exists :overwrite :if-does-not-exist :error)
    (write-string (vision:json-encode doc) s)))
(defun preparer (p)
  (let* ((d (lire p)) (uuid (j d "uuid"))
         (client (mrjam-oidc:faire-client-oidc "mrjam-vision" (j d "secret") (j d "curl")
                   :ca (j d "ca") :port (j d "port") :hotes '("vision.mrj.am" "logique.mrj.am"))))
    (setf *actif* t *cookie* nil
          *contexte* (mrjam-log::initialiser-oauth (mrjam-log:initialiser (mrjam-log:faire-contexte (j d "base")
            (list (cons "vision.mrj.am" client) (cons "logique.mrj.am" client))
            (lambda (issuer sub)
              (assert (equal issuer (mrjam-oidc:issuer-client "mrjam-vision")))
              (cond ((equal sub uuid)
                     (vision:jobject "actif" (if *actif* :true :false) "utilisateur" "alice" "administrateur" :true))
                    ((equal sub (j d "bob_uuid"))
                     (vision:jobject "actif" :true "utilisateur" "bob" "administrateur" :false))
                    (t (error "Sujet de fixture inconnu"))))))))
    (mrjam-log::base *contexte* (lambda (db)
      (mrjam-native:sqlite-requete db "INSERT INTO log_principaux VALUES(?,?,?,?,?)"
        (list uuid (j d "mail") 604800 "mfa" (j d "qualifie_a")))))
    (multiple-value-bind (uri cookie) (mrjam-log:demarrer *contexte* "vision.mrj.am" "/")
      (sauvegarder (j d "resultat") (vision:jobject "uri" uri "cookie" cookie)))
    :prepare))
(defun terminer (p)
  (let ((d (lire p)))
    (multiple-value-bind (retour cookie efface)
        (mrjam-log:retour *contexte* "vision.mrj.am" (j d "state") (j d "code") (j d "cookie"))
      (assert (equal retour "/")) (assert (search "Max-Age=0" efface))
      (setf *cookie* cookie))
    (assert (handler-case (progn (mrjam-log:retour *contexte* "vision.mrj.am"
                  (j d "state") (j d "code") (j d "cookie")) nil)
              (mrjam-oidc:oidc-error () t)))
    (reprendre p)
    (let* ((s (mrjam-log:session *contexte* "vision.mrj.am" *cookie*))
           (instant (mrjam-log::champ s "auth_time")))
      (assert (mrjam-log::verification-renforcee-p *contexte* s instant))
      (assert (not (mrjam-log::verification-renforcee-p *contexte* s (+ instant 900))))
      (assert (not (mrjam-log::verification-renforcee-p *contexte* s (1- instant)))))
    (assert (equal (j d "uuid") (mrjam-metier::nom-connexion-log *contexte* (j d "mail"))))
    (assert (equal "mrjam-compte-inconnu" (mrjam-metier::nom-connexion-log *contexte* "inconnu@example.test")))
    (oauth-verifier)
    (http-verifier p)))

(defun preparer-bob (p)
  (let ((d (lire p)))
    (multiple-value-bind (uri cookie) (mrjam-log:demarrer *contexte* "vision.mrj.am" "/")
      (sauvegarder (j d "resultat") (vision:jobject "uri" uri "cookie" cookie)))))
(defun terminer-bob (p)
  (let* ((d (lire p))
         (cookie (nth-value 1 (mrjam-log:retour *contexte* "vision.mrj.am" (j d "state") (j d "code") (j d "cookie")))))
    (assert (equal "bob" (mrjam-log::champ (mrjam-log:session *contexte* "vision.mrj.am" cookie) "username")))
    (assert (not (mrjam-log::verification-renforcee-p *contexte* (mrjam-log:session *contexte* "vision.mrj.am" cookie))))
    (let* ((verifier (mrjam-native:aleatoire-url))
           (client (mrjam-log::enregistrer-client *contexte* (vision:jobject "redirect_uris" (vision:jarray "https://client.example.test/retour"))))
           (demande (mrjam-log::demander-mcp *contexte* *cookie*
             (vision:jobject "client_id" (j client "client_id") "redirect_uri" "https://client.example.test/retour"
                "response_type" "code" "code_challenge_method" "S256"
                "code_challenge" (mrjam-native:base64 (mrjam-native::digest-octets (mrjam-native::octets verifier)) :url t :sans-remplissage t)
                "state" "alice" "scope" "vision:mcp" "resource" "https://vision.mrj.am/mcp"))))
      (assert (handler-case (progn (mrjam-log::consentir-mcp *contexte* cookie demande t) nil) (mrjam-log:log-error () t)))
      ;; Le refus Bob n'a pas consommé l'autorisation d'Alice.
      (assert (stringp (mrjam-log::consentir-mcp *contexte* *cookie* demande nil))))
    (let ((threads (loop for (c nom) in (list (list cookie "bob") (list *cookie* "alice")) collect
      (let ((c c) (nom nom)) (sb-thread:make-thread (lambda ()
        (dotimes (i 5) (assert (equal nom (mrjam-log::champ (mrjam-log:session *contexte* "vision.mrj.am" c) "username"))))
        :isole) :name "isolation synthetique")))))
      (dolist (thread threads) (assert (eq :isole (sb-thread:join-thread thread)))))
    (mrjam-log:deconnecter *contexte* "vision.mrj.am" cookie)
    (assert (null (mrjam-log:session *contexte* "vision.mrj.am" cookie)))
    (assert (equal "alice" (mrjam-log::champ (mrjam-log:session *contexte* "vision.mrj.am" *cookie*) "username")))
    :bob-isole))

(defun oauth-verifier ()
  (let* ((client (mrjam-log::enregistrer-client *contexte*
                   (vision:jobject "client_name" "Client synthétique"
                     "redirect_uris" (vision:jarray "https://client.example.test/retour"))))
         (id (j client "client_id")) (verifier (mrjam-native:aleatoire-url))
         (challenge (mrjam-native:base64 (mrjam-native::digest-octets (mrjam-native::octets verifier)) :url t :sans-remplissage t))
         (q (vision:jobject "client_id" id "redirect_uri" "https://client.example.test/retour"
             "response_type" "code" "code_challenge_method" "S256" "code_challenge" challenge
             "state" "etat-fixture" "scope" "vision:mcp" "resource" "https://vision.mrj.am/mcp"))
         (demande (mrjam-log::demander-mcp *contexte* *cookie* q)))
    (assert (equal (j (mrjam-log::lire-demande-mcp *contexte* *cookie* demande) "client") "Client synthétique"))
    (assert (handler-case
      (progn (mrjam-log::lire-demande-mcp *contexte* (mrjam-log:cookie-session (mrjam-native:aleatoire-url)) demande) nil)
      (mrjam-log:log-error () t)))
    (let* ((uri (mrjam-log::consentir-mcp *contexte* *cookie* demande t))
           (params (mrjam-metier::decode-query (subseq uri (1+ (position #\? uri)))))
           (code (j params "code"))
           (request (vision:jobject "grant_type" "authorization_code" "client_id" id "code" code
                      "redirect_uri" "https://client.example.test/retour" "code_verifier" verifier))
           (tokens (mrjam-log::jetons-mcp *contexte* request)))
      (assert (equal "etat-fixture" (j params "state")))
      (assert (equal "alice" (mrjam-log::verifier-mcp *contexte* (concatenate 'string "Bearer " (j tokens "access_token")))))
      (assert (handler-case (progn (mrjam-log::jetons-mcp *contexte* request) nil) (mrjam-log:log-error () t)))
      (let* ((refresh (vision:jobject "grant_type" "refresh_token" "client_id" id "refresh_token" (j tokens "refresh_token")))
             (new (mrjam-log::jetons-mcp *contexte* refresh)))
        (assert (not (equal (j new "refresh_token") (j tokens "refresh_token"))))
        (assert (equal "alice" (mrjam-log::verifier-mcp *contexte* (concatenate 'string "bearer " (j new "access_token")))))
        ;; Réutilisation d'un refresh consommé : toute sa famille est refusée.
        (assert (handler-case (progn (mrjam-log::jetons-mcp *contexte* refresh) nil) (mrjam-log:log-error () t)))
        (assert (null (mrjam-log::verifier-mcp *contexte* (concatenate 'string "Bearer " (j new "access_token")))))
        (assert (null (mrjam-log::verifier-mcp *contexte* (concatenate 'string "Bearer " (j tokens "access_token")))))))
    :oauth-verifie))
(defun http-verifier (p)
  (let* ((d (lire p)) (sortie (j d "http"))
         (s (mrjam-log:session *contexte* "vision.mrj.am" *cookie*))
         (headers (list '("x-forwarded-host" . "vision.mrj.am")
                        '("x-forwarded-proto" . "https")
                        '("x-original-method" . "GET") (cons "cookie" *cookie*))))
    (flet ((route (method chemin hs)
             (with-open-file (f sortie :direction :output :element-type '(unsigned-byte 8)
                               :if-exists :overwrite :if-does-not-exist :error)
               (mrjam-metier::router-log *contexte* f method chemin hs "{}"))
             (uiop:read-file-string sortie)))
      (assert (search "HTTP/1.1 204" (route "GET" "/verify" headers)))
      (assert (search "X-Mrj-User: alice" (uiop:read-file-string sortie)))
      (assert (search "HTTP/1.1 204" (route "GET" "/verify-gestion" headers)))
      (with-open-file (f sortie :direction :output :element-type '(unsigned-byte 8)
                         :if-exists :overwrite :if-does-not-exist :error)
        (mrjam-metier::proxy-connexion-log *contexte* f "POST" "/ui/login/begin"
          '(("x-forwarded-host" . "log.mrj.am") ("x-forwarded-proto" . "https")
            ("origin" . "https://log.mrj.am") ("content-type" . "application/x-www-form-urlencoded")
            ("hx-request" . "true"))
          (mrjam-oidc::formulaire-oidc (list (cons "username" (j d "mail"))))))
      (assert (search "HTTP/1.1 200" (uiop:read-file-string sortie)))
      ;; Le formulaire natif suivant demande réellement le second facteur.
      (assert (search "totp" (string-downcase (uiop:read-file-string sortie))))
      (assert (search "HTTP/1.1 200" (route "GET" "/auth/session" headers)))
      (assert (not (search "access_token" (uiop:read-file-string sortie))))
      (assert (not (search "refresh_token" (uiop:read-file-string sortie))))
      (assert (handler-case
                (progn (route "GET" "/verify"
                         (acons "x-original-method" "POST" (remove "x-original-method" headers :key #'car :test #'equal))) nil)
                (mrjam-metier:http-error (e) (= 403 (mrjam-metier:http-status e)))))
      (assert (search "HTTP/1.1 204" (route "GET" "/verify"
        (append (list '("origin" . "https://vision.mrj.am")
                      (cons "x-csrf-token" (mrjam-log::champ s "csrf")) '("x-original-method" . "POST"))
                (remove "x-original-method" headers :key #'car :test #'equal)))))
      :http-verifie)))
(defun reprendre (p)
  (declare (ignore p))
  (let ((s (mrjam-log:session *contexte* "vision.mrj.am" *cookie*)))
    (assert (equal "alice" (mrjam-log::champ s "username")))
    (assert (null (mrjam-log:session *contexte* "logique.mrj.am" *cookie*)))
    (assert (null (mrjam-log:session *contexte* "vision.mrj.am" "")))
    (setf *actif* nil)
    (assert (handler-case (progn (mrjam-log:session *contexte* "vision.mrj.am" *cookie*) nil)
              (mrjam-log:log-error () t)))
    (setf *actif* t)
    (assert (mrjam-log:session *contexte* "vision.mrj.am" *cookie*))
    :sessions-verifiees))
(defun logout ()
  (assert (search "Max-Age=0" (mrjam-log:deconnecter *contexte* "vision.mrj.am" *cookie*)))
  (assert (null (mrjam-log:session *contexte* "vision.mrj.am" *cookie*)))
  :logout-verifie)
