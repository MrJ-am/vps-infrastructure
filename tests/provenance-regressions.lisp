(defpackage #:mrjam-regressions (:use #:cl) (:export #:verifier-provenance))
(in-package #:mrjam-regressions)

(defun empreinte (chemin)
  (subseq (uiop:run-program (list "sha256sum" "--" (namestring chemin)) :output :string) 0 64))

(defun verifier-provenance (racine)
  "Refuser des attentes ou références modifiées ; aucun appel à Node."
  (let* ((fixtures (merge-pathnames "tests/fixtures/regressions/" racine))
         (p (vision:parse-json (uiop:read-file-string (merge-pathnames "PROVENANCE.json" fixtures))))
         (atelier (uiop:ensure-directory-pathname
                    (or (uiop:getenv "MRJAM_ATELIER")
                        (namestring (uiop:pathname-parent-directory-pathname racine))))))
    (assert (= 1 (vision:json-object-get p "format")))
    (assert (eq :false (vision:json-object-get p "autorise_publication")))
    (dolist (entree (vision:json-object-entries (vision:json-object-get p "fichiers")))
      (assert (member (car entree) '("matheval.json" "native.json") :test #'equal))
      (assert (equal (cdr entree) (empreinte (merge-pathnames (car entree) fixtures)))))
    (dolist (entree (vision:json-object-entries (vision:json-object-get p "references")))
      (let* ((nom (car entree)) (barre (position #\/ nom))
             (depot (subseq nom 0 barre)) (relatif (subseq nom (1+ barre)))
             (base (cond ((equal depot "vps") racine)
                         ((equal depot "matheval") (merge-pathnames "M-moire/" atelier))
                         (t (error "Référence hors périmètre.")))))
        (assert (and (not (uiop:absolute-pathname-p (pathname relatif)))
                     (not (member :up (pathname-directory (pathname relatif))))))
        (unless (equal (cdr entree) (empreinte (merge-pathnames relatif base)))
          (error "Référence modifiée : ~A ; fixture à requalifier." nom))))
    fixtures))
