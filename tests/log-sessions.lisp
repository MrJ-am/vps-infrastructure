(defpackage #:mrjam-log-tests (:use #:cl) (:export #:verifier))
(in-package #:mrjam-log-tests)
(defun verifier ()
  (let* ((secret (mrjam-native:aleatoire-url))
         (s (list (cons "csrf" secret))) (nombre 0))
    (flet ((oui (x) (assert x) (incf nombre))
           (non (f) (assert (handler-case (progn (funcall f) nil) (mrjam-log:log-error () t))) (incf nombre)))
      (oui (search "__Host-" (mrjam-log:cookie-session secret)))
      (oui (not (search "Domain=" (mrjam-log:cookie-session secret))))
      (oui (search "Secure; HttpOnly; SameSite=Lax" (mrjam-log:cookie-session secret)))
      (oui (search "Max-Age=0" (mrjam-log:cookie-session "" 0)))
      (non (lambda () (mrjam-log:cookie-session "x; injection")))
      (oui (equal secret (mrjam-log::token-cookie (mrjam-log:cookie-session secret) "__Host-mrj_session")))
      (non (lambda () (mrjam-log::token-cookie
        (format nil "__Host-mrj_session=~A; __Host-mrj_session=~A" secret secret) "__Host-mrj_session")))
      (oui (null (mrjam-log::token-cookie "__Host-mrj_session=bad" "__Host-mrj_session")))
      (oui (mrjam-log:csrf-valide-p s "https://vision.mrj.am" "vision.mrj.am" secret))
      (oui (not (mrjam-log:csrf-valide-p s "https://autre.test" "vision.mrj.am" secret)))
      (oui (not (mrjam-log:csrf-valide-p s "https://vision.mrj.am" "vision.mrj.am" "different")))
      (oui (not (mrjam-log:csrf-valide-p nil "https://vision.mrj.am" "vision.mrj.am" secret))))
    (format t "~&Log sessions : ~D assertions terminées.~%" nombre)
    t))
