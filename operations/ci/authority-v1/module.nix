{ config, lib, pkgs, ... }:
let
  cfg = config.services.mrjamValidationAuthority;
  worker = config.services.mrjamValidationWorker;
  closure = pkgs.closureInfo { rootPaths = [ worker.validator ]; };
  workerPolicy = {
    schema_version = 1;
    rules_revision = worker.rulesRevision;
    validator_store = toString worker.validator;
    bubblewrap_store = toString pkgs.bubblewrap;
    closure_file = "${closure}/store-paths";
  };
  producer = {
    schema_version = 1;
    rules_revision = cfg.policy.rules_revision;
    verifier = cfg.policy.verifier;
    verifier_nar_hash = cfg.policy.verifier_nar_hash;
    closure_sha256 = cfg.policy.closure_sha256;
    report_policy_sha256 = cfg.policy.report_policy_sha256;
    worker_policy_sha256 = builtins.hashString "sha256" (builtins.toJSON workerPolicy);
    producer_recipe_sha256 = builtins.hashFile "sha256" ./producer.py;
    worker_core_sha256 = builtins.hashFile "sha256" ../../forgejo/worker.py;
    collector_recipe_sha256 = builtins.hashFile "sha256" ./collector.py;
    contract_sha256 = builtins.hashFile "sha256" ./contract.py;
  };
  policy = cfg.policy // { inherit producer; };
  package = pkgs.callPackage ./package.nix { authorityPolicy = policy; producerBinding = producer; };
  baseService = {
    Type = "exec";
    NoNewPrivileges = true;
    CapabilityBoundingSet = "";
    AmbientCapabilities = "";
    UMask = "0077";
    ProtectSystem = "strict";
    ProtectHome = true;
    PrivateTmp = true;
    PrivateDevices = true;
    PrivateNetwork = true;
    ProtectProc = "invisible";
    ProcSubset = "pid";
    ProtectKernelTunables = true;
    ProtectKernelModules = true;
    ProtectKernelLogs = true;
    ProtectControlGroups = true;
    RestrictNamespaces = true;
    RestrictSUIDSGID = true;
    LockPersonality = true;
    RestrictRealtime = true;
    RestrictAddressFamilies = [ "AF_UNIX" ];
    InaccessiblePaths = [ "-/var/lib/forgejo" "-/var/lib/postgresql" "-/var/lib/kanidm" "-/var/lib/nextcloud" "-/var/lib/mrjam-identite" "-/var/backup" "-/var/backups" "-/var/run/docker.sock" "-/run/nix/daemon-socket" ];
    StandardOutput = "null";
    StandardError = "null";
    TasksMax = 8;
    RuntimeMaxSec = 20;
    TimeoutStopSec = 5;
    KillMode = "control-group";
    LimitCORE = 0;
    LimitFSIZE = 67108864;
  };
in {
  options.services.mrjamValidationAuthority = {
    enable = lib.mkEnableOption "separate content authority for freshly bound validation receipts";
    policy = lib.mkOption {
      type = lib.types.attrs;
      description = "Reviewed public authority policy; no signing key or candidate-selected field. Producer recipe binding is generated by this module.";
    };
    signingKeyFile = lib.mkOption {
      type = lib.types.strMatching "/var/lib/mrjam-validation-authority/[A-Za-z0-9._-]+";
      description = "Existing private local Ed25519 credential path, never a Nix source or value.";
    };
    package = lib.mkOption { type = lib.types.package; readOnly = true; default = package; };
    producerBinding = lib.mkOption { type = lib.types.attrs; readOnly = true; default = producer; };
  };
  config = lib.mkIf cfg.enable {
    assertions = [
      { assertion = worker.enable && config.services.mrjamValidationCollector.enable;
        message = "Validation authority requires the existing isolated worker and collector."; }
      { assertion = worker.rulesRevision == cfg.policy.rules_revision && config.services.mrjamValidationCollector.rulesRevision == cfg.policy.rules_revision && toString worker.validator == cfg.policy.verifier;
        message = "Authority, worker and collector must select identical rules and verifier."; }
      { assertion = config.users.users.mrjam-validation-collector.uid == cfg.policy.collector_uid;
        message = "Collector UID must be explicitly assigned and equal to the authority policy."; }
      { assertion = config.services.mrjamForgejoRunner.coordinatorUid == cfg.policy.requester_uid;
        message = "Only the separately assigned coordinator UID may request an attestation."; }
      { assertion = builtins.length (lib.unique [ cfg.policy.collector_uid cfg.policy.signer_uid cfg.policy.requester_uid ]) == 3
          && !(builtins.elem config.services.mrjamForgejoRunner.registrarUid [ cfg.policy.collector_uid cfg.policy.signer_uid cfg.policy.requester_uid ]);
        message = "Collector, signer, coordinator and registration identities must be distinct."; }
      { assertion = lib.all (proposal: builtins.elem proposal (map (entry: entry.sha256) config.services.mrjamValidationStaging.proposals)) cfg.policy.accepted_proposals;
        message = "An authority policy may admit only explicitly staged immutable proposals."; }
      { assertion = !(cfg.policy ? producer);
        message = "The producer recipe binding is module-owned, never supplied as a separate policy override."; }
    ];
    users.groups.mrjam-validation-authority = {};
    users.users.mrjam-validation-authority = {
      isSystemUser = true;
      uid = cfg.policy.signer_uid;
      group = "mrjam-validation-authority";
      hashedPassword = "!";
      home = "/var/empty";
      createHome = false;
    };
    environment.etc."mrjam-validation-authority/producer.json" = { text = builtins.toJSON producer; mode = "0444"; };
    systemd.tmpfiles.rules = [
      "d /run/mrjam-validation-authority 0755 root root -"
      "d /var/lib/mrjam-validation-collector/authority-v1 0700 mrjam-validation-collector mrjam-validation-collector -"
      "d /var/lib/mrjam-validation-collector/authority-v1/artifacts 0700 mrjam-validation-collector mrjam-validation-collector -"
    ];
    systemd.services."mrjam-validation-worker@".serviceConfig.ExecStart = lib.mkForce "${package}/bin/mrjam-validation-bound-worker";
    systemd.services."mrjam-validation-collector@".serviceConfig.ExecStart = lib.mkForce "${package}/bin/mrjam-validation-bound-collector";
    systemd.sockets.mrjam-validation-export = {
      socketConfig = {
        ListenSequentialPacket = "/run/mrjam-validation-authority/export.sock";
        Accept = true; MaxConnections = 1; Backlog = 1;
        SocketUser = "root"; SocketGroup = "mrjam-validation-authority";
        SocketMode = "0660"; RemoveOnStop = true;
      };
    };
    systemd.services."mrjam-validation-export@" = {
      restartIfChanged = false;
      serviceConfig = baseService // {
        ExecStart = "${package}/bin/mrjam-validation-export";
        User = "mrjam-validation-collector";
        Group = "mrjam-validation-collector";
        StandardInput = "socket";
        InaccessiblePaths = baseService.InaccessiblePaths ++ [ "-/run/credentials" ];
        ReadOnlyPaths = [ "/var/lib/mrjam-validation-collector/authority-v1" ];
        MemoryMax = "192M";
      };
    };
    systemd.sockets.mrjam-validation-authority = {
      socketConfig = {
        ListenSequentialPacket = "/run/mrjam-validation-authority/request.sock";
        Accept = false; Backlog = 1;
        SocketUser = "root"; SocketGroup = "mrjam-validation-requesters";
        SocketMode = "0660"; RemoveOnStop = true;
        FileDescriptorName = "authority-request";
      };
    };
    systemd.services.mrjam-validation-authority = {
      restartIfChanged = false;
      requires = [ "mrjam-validation-export.socket" ];
      after = [ "mrjam-validation-export.socket" ];
      serviceConfig = baseService // {
        ExecStart = "${package}/bin/mrjam-validation-attest";
        User = "mrjam-validation-authority";
        Group = "mrjam-validation-authority";
        LoadCredential = [ "signing-key:${cfg.signingKeyFile}" ];
        InaccessiblePaths = baseService.InaccessiblePaths ++ [ "-/var/lib/mrjam-validation-collector" ];
        MemoryMax = "256M";
      };
    };
  };
}
