"""Vrai module Nix verrouillé et PostgreSQL isolé : reload sans changement de PID.

Aucune construction du serveur métier. Dépendances déjà approuvées, Nix et
PostgreSQL/pgvector verrouillés ; conteneur sans réseau, store en lecture seule.
"""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile
import time
import uuid

ROOT=Path(__file__).resolve().parents[1]
IMAGE='mirror.gcr.io/pgvector/pgvector@sha256:40b404964359299eefdd5f8518facf1886c562848cf4de13b6eaf91cb70c2b87'


def verifier():
    verrou=json.loads((ROOT/'assemblage/manifest.json').read_text())['toolchain']['production']
    archive=ROOT/'state/outils-sources'/('nixpkgs-'+verrou['nixpkgs_revision']+'.tar.gz')
    archive.parent.mkdir(parents=True,exist_ok=True)
    env={k:v for k,v in os.environ.items() if k in ('PATH','HOME','LANG','LC_ALL','NIX_REMOTE','NIX_SSL_CERT_FILE')}
    if not archive.exists():
        # Pont réseau déjà fourni à l'atelier, uniquement pour cette lecture
        # officielle. Aucune valeur proxy/token ne passe au build ou au reçu.
        reseau=dict(env,**{k:os.environ[k] for k in ('HTTPS_PROXY','HTTP_PROXY','https_proxy','http_proxy','NO_PROXY','no_proxy') if k in os.environ})
        subprocess.run(['curl','--disable','--fail','--location','--silent','--show-error','--max-time','180',
                        verrou['source_url'],'--output',archive],env=reseau,check=True)
    assert hashlib.sha256(archive.read_bytes()).hexdigest()==verrou['source_archive_sha256']
    def run(args,**kw):
        try:return subprocess.run(list(map(str,args)),env=env,text=True,capture_output=True,check=True,**kw)
        except subprocess.CalledProcessError as e:raise AssertionError(e.stderr[-4000:]) from e
    with tempfile.TemporaryDirectory(prefix='qualification-pg-reload-',dir=ROOT/'state') as tmp:
        tmp=Path(tmp)
        with tarfile.open(archive) as t:t.extractall(tmp,filter='data')
        sources=[p for p in tmp.iterdir() if p.is_dir()];assert len(sources)==1
        source=sources[0];expression=tmp/'reload.nix'
        expression.write_text('''let
  pkgs = import '''+str(source)+''' { system="x86_64-linux"; };
  lib = pkgs.lib;
  c = (import '''+str(source)+'''/nixos/lib/eval-config.nix {
    system="x86_64-linux";
    modules = [ '''+str(ROOT/'modules/postgresql-rechargement.nix')+''' ({lib,pkgs,...}: {
      options.infrastructure.metier.enable = lib.mkEnableOption "fixture";
      config = {
        system.stateVersion="26.05";
        fileSystems."/"={ device="/dev/vda1"; fsType="ext4"; };
        boot.loader.grub.device="/dev/vda";
        infrastructure.metier.enable = true;
        services.postgresql = {
          enable=true; package=pkgs.postgresql_17;
          dataDir="/var/lib/postgresql/data";
          settings.unix_socket_directories="/var/run/postgresql";
          authentication=lib.mkForce "local all postgres peer\\nlocal all fixture peer map=mrjam_fixture\\n";
          identMap="mrjam_fixture nobody fixture";
        };
      };
    }) ];
  }).config;
  service=c.systemd.services.postgresql;
in {
  artefact=pkgs.writeText "qualification-postgresql-reloader" service.serviceConfig.ExecReload;
  meta={
  execReload=service.serviceConfig.ExecReload;
  reloadDrv=builtins.head (builtins.attrNames (builtins.getContext service.serviceConfig.ExecReload));
  reloadIfChanged=service.reloadIfChanged;
  assertions=map (a: a.assertion) c.assertions;
  };
}
''')
        r=json.loads(run(['nix-instantiate','--eval','--strict','--json',expression,'--attr','meta']).stdout)
        assert r['reloadIfChanged'] is True and r['assertions'] and all(r['assertions'])
        # --eval seul ne matérialise pas les .drv. Cette dérivation de texte
        # force uniquement le script et ses fichiers de configuration ; aucun
        # build d'image métier ni de génération système.
        env.update({k:os.environ[k] for k in ('HTTPS_PROXY','HTTP_PROXY','https_proxy','http_proxy','NO_PROXY','no_proxy') if k in os.environ})
        realise=run(['nix-build',expression,'--attr','artefact','--no-out-link','--max-jobs','1','--cores','2']).stdout.strip()
        assert Path(realise).read_text()==r['execReload']
        script=r['execReload'].split()[0];assert Path(script).is_file()
        nom='mrjam-pg-reload-'+uuid.uuid4().hex[:12]
        def docker(*args,check=True,input=None):
            return subprocess.run(['docker',*map(str,args)],text=True,input=input,capture_output=True,check=check)
        docker('run','--detach','--name',nom,'--network','none','--env','POSTGRES_HOST_AUTH_METHOD=trust',
               '--mount','type=bind,src=/nix/store,dst=/nix/store,readonly',IMAGE)
        try:
            for _ in range(100):
                if docker('exec',nom,'pg_isready','-U','postgres',check=False).returncode==0:break
                time.sleep(.1)
            else:raise AssertionError('PostgreSQL isolé absent')
            def sql(q):return docker('exec','-i',nom,'runuser','-u','postgres','--','psql','-XAtq',
                '-U','postgres','--set=ON_ERROR_STOP=1','--file=-',input=q).stdout.strip()
            sql('CREATE ROLE fixture LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;')
            avant=sql('SELECT pg_postmaster_start_time();')
            pid=docker('exec',nom,'head','-n','1','/var/lib/postgresql/data/postmaster.pid').stdout.strip()
            mauvais=docker('exec',nom,'runuser','-u','postgres','--',script,'999999999',check=False)
            assert mauvais.returncode!=0
            docker('exec',nom,'runuser','-u','postgres','--',script,pid)
            # SIGHUP est asynchrone ; attendre la propriété effectivement
            # chargée, sans relancer le rechargement.
            for _ in range(100):
                if sql('SHOW hba_file;').startswith('/nix/store/'):break
                time.sleep(.05)
            else:
                erreurs=sql("SELECT coalesce(json_agg(json_build_object('nom',name,'erreur',error)) FILTER (WHERE error IS NOT NULL),'[]') FROM pg_file_settings;")
                raise AssertionError('Nouvelle configuration non appliquée : '+erreurs+'\n'+docker('logs',nom).stderr[-2400:])
            assert sql('SELECT pg_postmaster_start_time();')==avant
            assert docker('exec',nom,'head','-n','1','/var/lib/postgresql/data/postmaster.pid').stdout.strip()==pid
            bonne=docker('exec',nom,'runuser','-u','nobody','--','psql','-XAtq','-U','fixture','-d','postgres','-c','SELECT current_user;')
            assert bonne.stdout.strip()=='fixture'
            refuse=docker('exec',nom,'psql','-XAtq','-U','fixture','-d','postgres','-c','SELECT current_user;',check=False)
            assert refuse.returncode!=0 and 'Peer authentication failed' in refuse.stderr
            print('Nix/PostgreSQL réels : module verrouillé, PID/démarrage inchangés, HBA/ident appliqués ; UID autorisé accepté, UID falsifié et mauvais PID refusés.')
        finally:docker('rm','--force','--volumes',nom)


if __name__=='__main__':verifier()
