{ config, lib, pkgs, ... }:
let
  pg = config.services.postgresql;
  # Le module officiel verrouillé construit ce lien dans preStart. Réutiliser
  # son fichier, pas une deuxième sérialisation des paramètres PostgreSQL.
  lignes = lib.splitString "\n" config.systemd.services.postgresql.preStart;
  liens = builtins.filter (l: lib.hasPrefix "ln -sfn " l) lignes;
  lien = if builtins.length liens == 1 then builtins.head liens else "";
  cible = builtins.match ''ln -sfn "(/nix/store/[a-z0-9]{32}-postgresql[.]conf)/postgresql[.]conf" "([^"]+)/postgresql[.]conf"'' lien;
  valide = cible != null && builtins.elemAt cible 1 == pg.dataDir;
  source = builtins.appendContext
    (if valide then builtins.elemAt cible 0 + "/postgresql.conf" else "/cible-invalide")
    (builtins.getContext config.systemd.services.postgresql.preStart);
  recharger = pkgs.writeShellScript "postgresql-metier-recharger" ''
    set -eu
    test -f ${lib.escapeShellArg (pg.dataDir + "/PG_VERSION")}
    test "$(${pkgs.coreutils}/bin/cat ${lib.escapeShellArg (pg.dataDir + "/postmaster.pid")} | ${pkgs.coreutils}/bin/head -n 1)" = "$1"
    ${pkgs.coreutils}/bin/ln -sfn ${lib.escapeShellArg source} ${lib.escapeShellArg (pg.dataDir + "/postgresql.conf")}
    exec ${pkgs.coreutils}/bin/kill -HUP "$1"
  '';
in {
  config = lib.mkIf config.infrastructure.metier.enable {
    assertions = [{ assertion = valide;
      message = "Rechargement PostgreSQL : lien du module officiel verrouillé non reconnu."; }];
    # HBA/ident sont rechargeables. Aucun package, dataDir, port ou autre
    # paramètre ne change ; le préparateur vérifie ces invariants séparément.
    systemd.services.postgresql.reloadIfChanged = true;
    systemd.services.postgresql.serviceConfig.ExecReload = lib.mkForce "${recharger} $MAINPID";
  };
}
