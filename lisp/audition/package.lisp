(defpackage #:mrjam-audition
  (:use #:cl)
  (:export #:faire-service #:appeler #:mcp #:catalogue-mcp #:politique
           #:audition-error #:code-erreur #:statut-erreur #:details-erreur
           #:logit-db #:afficher-db #:indicateur))
(in-package #:mrjam-audition)

(define-condition audition-error (error)
  ((code :initarg :code :reader code-erreur)
   (statut :initarg :statut :reader statut-erreur)
   (details :initarg :details :initform nil :reader details-erreur)))
(defun refuser (code &optional (statut 400) details)
  (error 'audition-error :code code :statut statut :details details))
(defun j (o k) (vision:json-object-get o k))
(defun objet (&rest p) (apply #'vision:jobject p))
(defun tableau (p) (vision:%make-json-array p))
(defun elements (p) (if (vision:json-array-p p) (vision:json-array-items p) (refuser "tableau_requis")))
(defun copier (p) (vision:parse-json (vision:json-encode p)))
(defun remplacer (o &rest p)
  (vision::%make-json-object
    (append (loop for (k v) on p by #'cddr collect (cons k v))
            (remove-if (lambda (e) (loop for k in p by #'cddr thereis (equal k (car e))))
                       (vision:json-object-entries o)))))
(defun texte-p (v maximum &optional (minimum 1))
  (and (stringp v) (<= minimum (length v) maximum) (not (find #\Null v))
       (or (zerop minimum) (plusp (length (string-trim '(#\Space #\Newline #\Return #\Tab) v))))))
(defun identifiant-p (v)
  (and (texte-p v 64) (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                                          (char<= #\0 c #\9) (find c "_-"))) v)))
(defun acteur-p (v)
  ;; Le compte métier central accepte aussi le point ; ne jamais le renommer.
  (and (texte-p v 64) (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                                         (char<= #\0 c #\9) (find c "_.-"))) v)))
(defun exiger (test code &optional (status 400)) (unless test (refuser code status)))
(defun champs (p requis optionnels)
  (exiger (vision:json-object-p p) "objet_requis")
  (exiger (and (every (lambda (k) (assoc k (vision:json-object-entries p) :test #'equal)) requis)
               (every (lambda (e) (member (car e) (append requis optionnels) :test #'equal))
                      (vision:json-object-entries p))) "champs_invalides"))
(defun entier (v min max) (and (integerp v) (<= min v max)))
(defun maintenant () (- (get-universal-time) 2208988800))
(defun lien (type id) (format nil "https://audition.mrj.am/#~A/~A" type id))
