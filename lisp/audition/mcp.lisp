(in-package #:mrjam-audition)

(defun schema-ferme (properties requis)
  (apply #'vision::object-schema (vision::%make-json-object properties) requis))
(defun schema-texte (max) (vision::string-schema :maximum-length max))
(defun schema-observation ()
  (schema-ferme (list (cons "critere" (schema-texte 64))
     (cons "etat" (vision::string-schema :enum *etats-observation*))
     (cons "justification" (schema-texte 4000)) (cons "points" (objet "type" "number" "minimum" 0))
     (cons "incertitude" (schema-texte 2000))) '("critere" "etat" "justification")))
(defun schema-aide ()
  (schema-ferme (list (cons "nature" (vision::string-schema :enum '("indice" "explication" "correction" "solution")))
     (cons "contenu" (schema-texte 8000)) (cons "activite_a" (vision::integer-schema :minimum 0 :maximum 4102444800)))
     '("nature" "contenu" "activite_a")))
(defun schema-document ()
  (let ((attendu (schema-ferme (list (cons "id" (schema-texte 64)) (cons "texte" (schema-texte 2000))) '("id" "texte")))
        (critere (schema-ferme (list (cons "id" (schema-texte 64)) (cons "attendu" (schema-texte 64))
                     (cons "texte" (schema-texte 2000)) (cons "maximum" (objet "type" "number" "exclusiveMinimum" 0 "exclusiveMaximum" 1001)))
                   '("id" "attendu" "texte" "maximum"))))
    (objet "oneOf" (vision:jarray
      (schema-ferme (list (cons "titre" (schema-texte 200)) (cons "contenu" (schema-texte 32000))) '("titre" "contenu"))
      (schema-ferme (list (cons "titre" (schema-texte 200)) (cons "consigne" (schema-texte 16000))
         (cons "attendus" (vision::array-schema attendu :maximum 32))
         (cons "criteres" (vision::array-schema critere :maximum 64))
         (cons "cours" (schema-texte 64)) (cons "cours_version" (vision::integer-schema :minimum 1))
         (cons "corrige" (schema-texte 16000)) (cons "publication_corrige" (vision::integer-schema :minimum 0 :maximum 4102444800))
         (cons "type" (vision::string-schema :enum '("ouverte" "qcm")))
         (cons "propositions" (vision::integer-schema :minimum 2 :maximum 100))) '("titre" "consigne" "attendus" "criteres"))))))

(defun schema-champ (nom)
  (cond
    ((equal nom "document") (schema-document))
    ((equal nom "aides") (vision::array-schema (schema-aide) :maximum 32))
    ((equal nom "observations") (vision::array-schema (schema-observation) :maximum 64))
    ((equal nom "role") (vision::string-schema :enum '("enseignant" "eleve" "retirer")))
    ((equal nom "action") (vision::string-schema :enum '("reprendre" "interrompre" "terminer")))
    ((equal nom "etat") (vision::string-schema :enum *etats-observation*))
    ((member nom '("revision" "activite_version" "politique_version" "echeance" "activite_a" "offset" "limite") :test #'equal)
     (objet "type" "integer" "minimum" (if (member nom '("offset" "echeance" "activite_a") :test #'equal) 0 1) "description" (if (member nom '("echeance" "activite_a") :test #'equal)
                   "Secondes Unix UTC ; heure de l'activité distincte de la réception." "Version serveur ou pagination, jamais à deviner.")))
    ((member nom '("document" "observation") :test #'equal)
     (if (equal nom "observation") (objet "type" "string" "maxLength" 64)
       (objet "type" "object" "description" "Activité : titre, consigne, attendus [{id,texte}], critères [{id,attendu,texte,maximum}]. Cours : titre et contenu.")))
    ((member nom '("eleves" "aides" "observations") :test #'equal)
     (objet "type" "array" "maxItems" (if (equal nom "eleves") 500 64)
       "items" (if (equal nom "eleves") (objet "type" "string" "maxLength" 64)
                  (objet "type" "object" "description" (if (equal nom "aides")
                     "{nature: indice|explication|correction|solution, contenu, activite_a}"
                     "{critere, etat: non_observe|en_cours|difficulte|reussite_aidee|reussite_autonome, justification, points?, incertitude?}")))))
    ((equal nom "points") (objet "type" "number" "minimum" 0))
    (t (objet "type" "string" "maxLength" (if (member nom '("production" "consigne" "justification" "annotation") :test #'equal) 16000 200)))))
(defun description-outil (nom)
  (or (cdr (assoc nom
    '(("contexte" . "Démarrage : groupes réellement autorisés, politique pédagogique et URL MCP. Aucun rôle déclaré par le client.")
      ("ouvrir_seance" . "Ouvrir ou retrouver la séance unique de l'élève pour une affectation. Lire consignes/version/politique, annoncer le cadre puis laisser l'élève répondre.")
      ("consulter_seance" . "Relire état réel après interruption ou timeout. Traces paginées, consignes effectives et version actuelle, changements et prochaines actions.")
      ("adopter_contexte" . "Prise en compte explicite des nouvelles consignes dans une séance ouverte. Historique préservé. Exiger la version actuelle.")
      ("consigner" . "Enregistrer atomiquement production rapportée, aides effectivement apportées et observations justifiées. Clé stable en cas de rejeu, révision exacte. Une solution n'est pas une réussite autonome.")
      ("transition" . "Interrompre, reprendre ou terminer. Terminer exige des observations sur chaque critère, sans attribuer de réussite aux critères manquants.")
      ("rectifier" . "Enseignant rattaché : annoter ou corriger une interprétation, avec justification et historique attribué.")
      ("rapport" . "Enseignant rattaché : rapports paginés, versions/critères/aides/effectifs, difficultés communes et liens vers preuves. Non observé distinct de l'échec.")
      ("activite" . "Enseignant rattaché : proposer/versionner consignes, attendus, critères et barèmes. Une proposition MCP reste non officielle jusqu'à son enregistrement par l'enseignant dans l'interface web. Corrigé privé avant publication UTC.")
      ("affecter" . "Enseignant rattaché : prescrire une activité versionnée aux élèves du groupe, avec échéance UTC.")
      ("remediation" . "Prescrire une nouvelle affectation de remédiation, consigne et origine traçables ; un LLM ne peut officialiser sa proposition.")
      ("travaux" . "Travail affecté et prochaine séance utile, sans divulguer les élèves voisins ou les corrigés non publiés.")
      ("supprimer_groupe" . "Administration explicitement habilitée : suppression des données du groupe, confirmation égale à l'identifiant. Action sensible auditée.")) :test #'equal))
      "Opération métier autorisée côté serveur, selon les rattachements. Consulter le guide canonique https://audition.mrj.am/#aide."))
(defun schema-sortie (nom)
  (let ((objet-libre (objet "type" "object"))
        (objet-optionnel (objet "oneOf" (vision:jarray (objet "type" "object") (objet "type" "null"))))
        (id (schema-texte 64)) (n (vision::integer-schema :minimum 0)))
    (cond
      ((member nom '("contexte" "membres" "preparations" "travaux" "rapport") :test #'equal)
       (objet "type" "object" "required" (vision:jarray "elements" "total" "suivant")
         "properties" (objet "elements" (vision::array-schema objet-libre :maximum 100) "total" n
           "suivant" (objet "oneOf" (vision:jarray n (objet "type" "null")))
           "acteur" id "administrateur" (objet "type" "boolean") "politique" objet-libre
           "indicateurs" objet-libre "methode" (schema-texte 2000))
         "description" "Page bornée. Conserver les identifiants/versions et suivre suivant ; total ne compte pas des réussites."))
      ((member nom '("ouvrir_seance" "consulter_seance" "adopter_contexte" "consigner" "transition" "rectifier") :test #'equal)
       (objet "type" "object" "required" (vision:jarray "seance" "activite" "politique" "contexte_modifie")
         "properties" (objet "seance" objet-libre "activite" objet-libre "cours" objet-optionnel
           "politique" objet-libre "activite_version" n "version_actuelle" n
           "contexte_modifie" (objet "type" "boolean") "nouvelle_activite" objet-optionnel
           "traces" objet-libre "actions_suivantes" (vision::array-schema (schema-texte 80) :maximum 20))
         "description" "Séance contient id,revision,document. Lire politique.version et les versions effectives avant une écriture ; traces est une page."))
      ((member nom '("cours" "activite" "affecter") :test #'equal)
       (objet "type" "object" "required" (vision:jarray "id" "groupe" "nature" "revision" "document")
         "properties" (objet "id" id "groupe" id "nature" id "revision" n "document" objet-libre "url" (schema-texte 512))
         "description" "Version enregistrée. Les cours/activités proposés par MCP ont document.validee=false, sans prescription implicite."))
      (t (objet "type" "object" "properties" (objet "id" id "confirme" (objet "type" "boolean")
            "supprime" (objet "type" "boolean") "objet" objet-optionnel "url" (schema-texte 512))
          "description" "Résultat métier. Une erreur MCP a isError=true et structuredContent {erreur,statut,details,reprise}.")))))
(defun catalogue-mcp ()
  (tableau (loop for (nom droit requis optionnels) in *operations* collect
    (objet "name" nom "description" (description-outil nom)
      "inputSchema" (objet "type" "object" "additionalProperties" :false
         "required" (tableau requis)
         "properties" (vision::%make-json-object (loop for k in (append requis optionnels) collect (cons k (schema-champ k)))))
      "outputSchema" (schema-sortie nom)
      "annotations" (objet "readOnlyHint" (if (member "cle" requis :test #'equal) :false :true)
        "idempotentHint" :true "destructiveHint" (if (equal nom "supprimer_groupe") :true :false) "openWorldHint" :false)
      "_meta" (objet "droit" (string-downcase (symbol-name droit)))))))
(defun mcp (service acteur corps)
  "Adaptateur du transport MCP existant, sans listener ni protocole réécrit."
  (let ((vision::*mcp-tools* (catalogue-mcp))
        (vision::*mcp-server-info* (objet "name" "audition" "title" "Audition" "version" "0.1.0"))
        (vision::*instructions-mcp* (vision:json-encode (politique)))
        (vision::*mcp-invoker*
          (lambda (nom arguments)
            (handler-case
              (let ((resultat (appeler service acteur nom arguments :canal "mcp")))
                (objet "isError" :false "structuredContent" resultat
                       "content" (vision:jarray (objet "type" "text" "text" (vision:json-encode resultat)))))
              (audition-error (e)
                (let ((doc (objet "erreur" (code-erreur e) "statut" (statut-erreur e)
                      "details" (or (details-erreur e) :null) "reprise" "Relire contexte/consulter_seance ; un timeout ne prouve pas l'absence d'écriture.")))
                  (objet "isError" :true "structuredContent" doc
                    "content" (vision:jarray (objet "type" "text" "text" (vision:json-encode doc))))))))))
    (vision::handle-mcp-message corps)))
