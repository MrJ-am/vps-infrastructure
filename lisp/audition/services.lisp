(in-package #:mrjam-audition)

;; Contrat unique web/MCP. Rôles issus exclusivement du dépôt de droits serveur.
(defparameter *operations*
  '(("contexte" :lecture nil ("offset" "limite"))
    ("retrouver" :lecture ("id") nil)
    ("creer_groupe" :admin ("nom" "cle") nil)
    ("habiliter" :admin ("groupe" "acteur" "role" "cle") nil)
    ("membres" :admin ("groupe") ("offset" "limite"))
    ("diagnostic" :admin nil nil)
    ("supprimer_groupe" :admin ("groupe" "confirmation" "cle") nil)
    ("cours" :enseignant ("groupe" "document" "cle") ("id" "revision"))
    ("activite" :enseignant ("groupe" "document" "cle") ("id" "revision"))
    ("preparations" :enseignant ("groupe") ("offset" "limite"))
    ("affecter" :enseignant ("groupe" "activite" "eleves" "echeance" "cle") ("id" "revision"))
    ("travaux" :lecture ("groupe") ("offset" "limite"))
    ("ouvrir_seance" :eleve ("groupe" "affectation" "cle") nil)
    ("consulter_seance" :lecture ("groupe" "id") ("offset" "limite"))
    ("adopter_contexte" :eleve ("groupe" "id" "revision" "activite_version" "cle") nil)
    ("consigner" :eleve ("groupe" "id" "revision" "activite_version" "politique_version" "production" "activite_a" "aides" "observations" "cle") nil)
    ("transition" :eleve ("groupe" "id" "revision" "action" "cle") nil)
    ("rapport" :enseignant ("groupe") ("activite" "eleve" "offset" "limite"))
    ("rectifier" :enseignant ("groupe" "id" "revision" "tentative" "observation" "justification" "cle") ("points" "etat" "annotation"))
    ("remediation" :enseignant ("groupe" "activite" "eleves" "consigne" "cle") ("origine" "echeance"))))

(defun definition (nom) (or (assoc nom *operations* :test #'equal) (refuser "operation_inconnue" 404)))
(defun ecriture-p (nom) (member "cle" (third (definition nom)) :test #'equal))
(defun canonique (p)
  (cond ((vision:json-object-p p)
         (vision::%make-json-object (mapcar (lambda (e) (cons (car e) (canonique (cdr e))))
            (sort (copy-list (vision:json-object-entries p)) #'string< :key #'car))))
        ((vision:json-array-p p) (tableau (mapcar #'canonique (elements p)))) (t p)))
(defun paginer (liste p)
  (let ((offset (or (j p "offset") 0)) (limite (or (j p "limite") 50)))
    (exiger (and (entier offset 0 100000) (entier limite 1 100)) "pagination_invalide")
    (let ((choix nil) (octets 0))
      (loop for item in (nthcdr offset liste) for n below limite
            for taille = (length (sb-ext:string-to-octets (vision:json-encode item) :external-format :utf-8)) do
        (when (and choix (> (+ octets taille) 262144)) (return))
        (push item choix) (incf octets taille))
      (objet "elements" (tableau (nreverse choix)) "total" (length liste)
             "suivant" (if (< (+ offset (length choix)) (length liste)) (+ offset (length choix)) :null)))))
(defun autoriser (base acteur nom p)
  (let* ((d (definition nom)) (droit (second d)) (groupe (j p "groupe")) (r (and groupe (role base groupe acteur))))
    (case droit
      (:admin (exiger (administrateur-p base acteur) "administration_interdite" 403)
              (when (and groupe (not (equal nom "supprimer_groupe")))
                (exiger (find groupe (groupes base acteur) :key (lambda (g) (j g "id")) :test #'equal)
                                   "groupe_indisponible" 404)))
      (:enseignant (exiger (equal r "enseignant") "groupe_interdit" 403))
      (:eleve (exiger (equal r "eleve") "groupe_interdit" 403))
      (:lecture (when groupe (exiger (member r '("enseignant" "eleve") :test #'equal) "groupe_interdit" 403))))
    r))
(defun charger (base id groupe &optional nature)
  (exiger (identifiant-p id) "identifiant_invalide")
  (let ((o (lire base id)))
    (exiger (and o (equal groupe (j o "groupe")) (or (null nature) (equal nature (j o "nature")))) "objet_indisponible" 404)
    o))
(defun verifier-revision (o p)
  (exiger (and (entier (j p "revision") 1 1000000000) (= (j o "revision") (j p "revision")))
          "conflit_revision" 409))
(defun sauver (base o document acteur temps)
  (when (equal (j o "nature") "seance")
    (setf document (remplacer document "synthese" (tableau (dernieres-observations document))
                                      "total_tentatives" (length (elements (j document "tentatives"))))))
  (exiger (<= (length (sb-ext:string-to-octets (vision:json-encode document) :external-format :utf-8)) 900000) "limite_traces_atteinte" 409)
  (ecrire base (j o "id") (j o "groupe") (j o "nature") (1+ (j o "revision")) document acteur temps))
(defun creer (base groupe nature document acteur temps)
  (exiger (< (length (lister base groupe nature)) 2000) "capacite_groupe_atteinte" 409)
  (ecrire base (mrjam-native:aleatoire-url) groupe nature 1 document acteur temps))
(defun presenter (o &optional document)
  (objet "id" (j o "id") "revision" (j o "revision") "groupe" (j o "groupe") "nature" (j o "nature")
         "document" (or document (j o "document")) "url" (lien (j o "nature") (j o "id"))))
(defun prescription-version (a)
  (or (j (j a "document") "version_prescrite") 0))
(defun cible-eleves (base groupe eleves)
  (let ((liste (elements eleves)))
    (exiger (and (<= 1 (length liste) 500) (= (length liste) (length (remove-duplicates liste :test #'equal)))
                 (every (lambda (a) (and (acteur-p a) (equal "eleve" (role base groupe a)))) liste)) "eleves_invalides")))
(defun seance-propre (base acteur p r)
  (let ((o (charger base (j p "id") (j p "groupe") "seance")))
    (exiger (or (equal r "enseignant") (equal acteur (j (j o "document") "eleve"))) "seance_interdite" 403)
    (when (equal r "eleve")
      (let ((aff (charger base (j (j o "document") "affectation") (j p "groupe") "affectation")))
        (exiger (member acteur (elements (j (j aff "document") "eleves")) :test #'equal) "affectation_interdite" 403)))
    o))
(defun contexte-seance (base o r temps p)
  (let* ((s (j o "document")) (a (charger base (j s "activite") (j o "groupe") "activite"))
         (courant (prescription-version a)) (modifie (/= courant (j s "activite_version")))
         (doc (version base (j a "id") (j s "activite_version")))
         (tentatives (elements (j s "tentatives"))))
    (objet "seance" (presenter o (remplacer s "tentatives" (j (paginer tentatives p) "elements")))
      "traces" (paginer tentatives p)
      "cours" (if (and (j doc "cours") (plusp (or (j doc "cours_version") 0)))
                   (presenter (remplacer (charger base (j doc "cours") (j o "groupe") "cours") "revision" (j doc "cours_version"))
                     (version base (j doc "cours") (j doc "cours_version"))) :null)
      "activite" (presenter (remplacer a "revision" (j s "activite_version")) (activite-visible doc (equal r "enseignant") temps))
      "nouvelle_activite" (if modifie (presenter (remplacer a "revision" courant)
                                     (activite-visible (version base (j a "id") courant) (equal r "enseignant") temps)) :null)
      "activite_version" (j s "activite_version") "version_actuelle" courant "politique" (politique)
      "contexte_modifie" (if modifie :true :false)
      "informations_manquantes" (if (null tentatives) (vision:jarray "production et observations") (vision:jarray))
      "actions_suivantes" (tableau (cond ((equal (j s "etat") "terminee") '("consulter_seance"))
                       ((equal (j s "etat") "interrompue") '("consulter_seance" "reprendre"))
                       (modifie '("consulter_seance" "adopter_contexte" "interrompre"))
                       (t '("consigner" "interrompre" "terminer")))))))

(defun dernieres-observations (s)
  (when (and (j s "total_tentatives") (null (elements (j s "tentatives"))))
    (return-from dernieres-observations (elements (j s "synthese"))))
  (let ((result nil))
    (dolist (tentative (elements (j s "tentatives")))
      (dolist (observation (elements (j tentative "observations")))
        (setf result (remove (j observation "critere") result :key (lambda (o) (j o "critere")) :test #'equal))
        (push (remplacer observation "tentative" (j tentative "id") "activite_version" (j tentative "activite_version")) result)))
    ;; Rectifications attribuées/historisées ; les données brutes sont préservées.
    (dolist (correction (elements (j s "rectifications")))
      (when (and (j correction "etat") (not (eq (j correction "etat") :null)))
        (let ((o (find (j correction "critere") result :key (lambda (o) (j o "critere")) :test #'equal)))
          (when (and o (equal (j o "tentative") (j correction "tentative")))
            (setf result (substitute (remplacer o "etat" (j correction "etat") "rectification" correction) o result))))))
    (nreverse result)))

(defun indicateurs-rapport (lignes base)
  "Effectifs de dernières observations, regroupés par activité/version/critère.
Les aides restent séparées, le barème pondéré n'est pas une proportion."
  (let ((groupes (make-hash-table :test #'equal)) (documents (make-hash-table :test #'equal)))
    (dolist (ligne lignes)
      (dolist (critere (elements (j ligne "criteres")))
        (let* ((cle (list (j ligne "activite") (j ligne "activite_version") (j critere "id")))
               (obs (find (j critere "id") (elements (j ligne "observations")) :key (lambda (o) (j o "critere")) :test #'equal)))
          (push obs (gethash cle groupes)))))
    (tableau (loop for cle in (sort (loop for k being the hash-keys of groupes collect k) #'string< :key #'prin1-to-string)
      for observations = (gethash cle groupes)
      for definies = (remove-if-not (lambda (o) (and o (member (j o "etat") '("difficulte" "reussite_aidee" "reussite_autonome") :test #'equal)
                                                    (not (j o "incertitude")))) observations)
      for aides = (count "reussite_aidee" definies :key (lambda (o) (j o "etat")) :test #'equal)
      for autonomes = (count "reussite_autonome" definies :key (lambda (o) (j o "etat")) :test #'equal)
      for doc = (or (gethash (subseq cle 0 2) documents)
                    (setf (gethash (subseq cle 0 2) documents) (version base (first cle) (second cle)))) collect
        (remplacer (indicateur (+ aides autonomes) (length definies)
                    :propositions (when (equal (j doc "type") "qcm") (j doc "propositions")))
          "activite" (first cle) "activite_version" (second cle) "critere" (third cle)
          "prescrits" (length observations) "reussites_aidees" aides "reussites_autonomes" autonomes
          "difficultes" (count "difficulte" definies :key (lambda (o) (j o "etat")) :test #'equal)
          "non_observes_ou_incertains" (- (length observations) (length definies))
          "couverture" (if observations (/ (coerce (length definies) 'double-float) (length observations)) :null))))))

(defun effectuer (base acteur nom p r temps canal)
  (let ((groupe (j p "groupe")))
    (cond
      ((equal nom "contexte")
       (remplacer (paginer (groupes base acteur) p) "acteur" acteur "administrateur" (if (administrateur-p base acteur) :true :false)
         "politique" (politique) "mcp" "https://audition.mrj.am/mcp" "fuseau" "UTC"))
      ((equal nom "retrouver")
       (exiger (identifiant-p (j p "id")) "identifiant_invalide")
       (let ((o (lire base (j p "id"))))
         (exiger o "objet_indisponible" 404)
         (let ((r (role base (j o "groupe") acteur)) (doc (j o "document")))
           (exiger (member r '("enseignant" "eleve") :test #'equal) "objet_indisponible" 404)
           (when (equal (j o "nature") "seance")
             (seance-propre base acteur (objet "id" (j o "id") "groupe" (j o "groupe")) r)
             (setf doc (objet)))
           (when (and (equal r "eleve") (member (j o "nature") '("activite" "cours") :test #'equal))
             (exiger (some (lambda (aff)
               (let* ((a (charger base (j (j aff "document") "activite") (j o "groupe") "activite"))
                      (d (version base (j a "id") (prescription-version a))))
                 (or (and (equal (j o "nature") "activite") (equal (j a "id") (j o "id")))
                     (and (equal (j o "nature") "cours") (equal (j d "cours") (j o "id"))))))
               (lister base (j o "groupe") "affectation")) "objet_indisponible" 404)
             (setf doc (version base (j o "id") (prescription-version o))
                   o (remplacer o "revision" (prescription-version o))))
           (objet "id" (j o "id") "groupe" (j o "groupe") "nature" (j o "nature")
             "objet" (presenter o (if (equal (j o "nature") "activite") (activite-visible doc (equal r "enseignant") temps) doc))
             "url" (lien (j o "nature") (j o "id"))))))
      ((equal nom "creer_groupe")
       (exiger (< (length (groupes base acteur)) 500) "capacite_groupes_atteinte" 409)
       (exiger (texte-p (j p "nom") 200) "nom_invalide")
       (let ((id (mrjam-native:aleatoire-url))) (creer-groupe base id (j p "nom") acteur temps)
         (objet "id" id "nom" (j p "nom"))))
      ((equal nom "habiliter")
       (exiger (and (acteur-p (j p "acteur"))
                    (member (j p "role") '("enseignant" "eleve" "retirer") :test #'equal)) "habilitation_invalide")
       (exiger (or (equal (j p "role") "retirer") (< (length (membres base groupe)) 500)
                    (role base groupe (j p "acteur"))) "capacite_groupe_atteinte" 409)
       (changer-membre base groupe (j p "acteur") (j p "role") acteur temps)
       (objet "confirme" :true))
      ((equal nom "membres") (paginer (membres base groupe) p))
      ((equal nom "diagnostic") (diagnostic base))
      ((equal nom "preparations")
       (remplacer (paginer (mapcar #'presenter (lister base groupe "activite")) p)
                   "cours" (j (paginer (mapcar #'presenter (lister base groupe "cours")) p) "elements")
                   "eleves" (tableau (remove-if-not (lambda (m) (equal (j m "role") "eleve")) (membres base groupe)))))
      ((equal nom "supprimer_groupe")
       (exiger (equal (j p "confirmation") groupe) "confirmation_requise")
       (exiger (find groupe (groupes base acteur) :key (lambda (g) (j g "id")) :test #'equal) "groupe_indisponible" 404)
       (supprimer-groupe base groupe acteur temps) (objet "supprime" :true))
      ((member nom '("cours" "activite") :test #'equal)
       (let* ((document (j p "document")) (id (j p "id"))
              (ancien (when id (charger base id groupe nom))))
         (if (equal nom "activite") (valider-activite document)
             (progn (champs document '("titre" "contenu") nil)
                    (exiger (and (texte-p (j document "titre") 200) (texte-p (j document "contenu") 32000)) "cours_invalide")))
         (when (j document "cours")
           (let ((cours (charger base (j document "cours") groupe "cours")))
             (when (equal canal "web") (exiger (plusp (prescription-version cours)) "proposition_non_validee" 409))
             (setf document (remplacer document "cours_version" (prescription-version cours)))))
         (when ancien (verifier-revision ancien p))
         ;; Le canal est imposé par l'adaptateur serveur. Une proposition MCP
         ;; ne peut se déclarer prescription ; son enregistrement web par un
         ;; enseignant est la validation explicite. Les séances gardent la
         ;; dernière version officiellement prescrite pendant cette préparation.
         (let ((officiel (equal canal "web")))
           (setf document (remplacer document "origine" (if officiel "prescription_enseignant" "proposition_llm")
                       "validee" (if officiel :true :false) "auteur" acteur "recu_a" temps
                       "version_prescrite" (if officiel (if ancien (1+ (j ancien "revision")) 1)
                                                          (if ancien (prescription-version ancien) 0)))))
         (presenter (if ancien (sauver base ancien document acteur temps) (creer base groupe nom document acteur temps)))))
      ((member nom '("affecter" "remediation") :test #'equal)
       (let ((a (charger base (j p "activite") groupe "activite"))
             (ancien (when (j p "id") (charger base (j p "id") groupe "affectation"))))
         (exiger (eq :true (j (j a "document") "validee")) "proposition_non_validee" 409)
         (when ancien
           (verifier-revision ancien p)
           (exiger (equal (j (j ancien "document") "activite") (j p "activite")) "activite_affectee_immuable" 409))
         (cible-eleves base groupe (j p "eleves"))
         (exiger (entier (j p "echeance") 0 4102444800) "echeance_invalide")
         (when (equal nom "remediation") (exiger (texte-p (j p "consigne") 8000) "consigne_invalide"))
         (when (j p "origine") (charger base (j p "origine") groupe "seance"))
         (let ((doc (objet "activite" (j a "id") "activite_version" (j a "revision") "eleves" (j p "eleves")
             "echeance" (j p "echeance") "fuseau" "UTC" "prescrit_par" acteur "prescrit_a" temps
             "remediation" (if (equal nom "remediation") :true :false)
             "consigne_remediation" (or (j p "consigne") :null) "origine" (or (j p "origine") :null))))
           (presenter (if ancien (sauver base ancien doc acteur temps) (creer base groupe "affectation" doc acteur temps))))))
      ((equal nom "travaux")
       (let* ((affectations (remove-if-not (lambda (a) (or (equal r "enseignant")
                      (member acteur (elements (j (j a "document") "eleves")) :test #'equal))) (lister base groupe "affectation")))
              (sessions (lister base groupe "seance")))
         (paginer (mapcar (lambda (aff)
           (let* ((d (j aff "document")) (a (charger base (j d "activite") groupe "activite"))
                  (s (find-if (lambda (s) (and (equal (j (j s "document") "affectation") (j aff "id"))
                                               (equal (j (j s "document") "eleve") acteur))) sessions)))
             (objet "affectation" (presenter aff (if (equal r "enseignant") d
                                                     (remplacer d "eleves" (vision:jarray acteur))))
               "activite" (presenter (remplacer a "revision" (prescription-version a))
                  (activite-visible (version base (j a "id") (prescription-version a)) (equal r "enseignant") temps))
               "seance" (if s (presenter s (remplacer (j s "document") "tentatives" (vision:jarray))) :null)))) affectations) p)))
      ((equal nom "ouvrir_seance")
       (let* ((aff (charger base (j p "affectation") groupe "affectation")) (d (j aff "document"))
              (a (charger base (j d "activite") groupe "activite"))
              (ancien (find-if (lambda (s) (and (equal (j (j s "document") "affectation") (j aff "id"))
                                    (equal (j (j s "document") "eleve") acteur))) (lister base groupe "seance"))))
         (exiger (member acteur (elements (j d "eleves")) :test #'equal) "affectation_interdite" 403)
         (contexte-seance base (or ancien (creer base groupe "seance"
            (objet "affectation" (j aff "id") "activite" (j a "id") "activite_version" (prescription-version a)
              "eleve" acteur "etat" "en_cours" "ouverte_a" temps "reprise_a" temps
              "tentatives" (vision:jarray) "rectifications" (vision:jarray) "transitions" (vision:jarray)) acteur temps)) r temps p)))
      ((member nom '("consulter_seance" "adopter_contexte" "consigner" "transition" "rectifier") :test #'equal)
       (let* ((o (seance-propre base acteur p r)) (s (j o "document"))
              (a (charger base (j s "activite") groupe "activite")))
         (unless (equal nom "consulter_seance") (verifier-revision o p))
         (cond
           ((equal nom "consulter_seance") (contexte-seance base o r temps p))
           ((equal nom "adopter_contexte")
            (exiger (equal (j s "etat") "en_cours") "transition_interdite" 409)
            (exiger (eql (j p "activite_version") (prescription-version a)) "contexte_modifie" 409)
            (contexte-seance base (sauver base o (remplacer s "activite_version" (prescription-version a)
                "transitions" (tableau (append (elements (j s "transitions"))
                  (list (objet "action" "adopter_contexte" "ancienne_version" (j s "activite_version")
                                "version" (prescription-version a) "auteur" acteur "recu_a" temps))))) acteur temps) r temps p))
           ((equal nom "consigner")
            (exiger (equal (j s "etat") "en_cours") "seance_non_ouverte" 409)
            (exiger (and (eql (j p "activite_version") (j s "activite_version"))
                         (= (prescription-version a) (j s "activite_version"))) "contexte_modifie" 409)
            (exiger (eql (j p "politique_version") 1) "politique_modifiee" 409)
            (exiger (texte-p (j p "production") 16000) "production_manquante")
            (valider-date (j p "activite_a") temps)
            (let* ((aides (elements (j p "aides"))) (observations (elements (j p "observations")))
                   (tentatives (elements (j s "tentatives"))) (doc (version base (j a "id") (prescription-version a))))
              (exiger (and (< (length tentatives) 128) (<= (length aides) 32) (<= 1 (length observations) 64)) "limite_traces_atteinte" 409)
              (setf aides (mapcar (lambda (aide) (valider-aide aide temps)) aides))
              (setf observations (mapcar (lambda (obs) (observer obs doc aides temps)) observations))
              (exiger (= (length observations) (length (remove-duplicates observations :key (lambda (obs) (j obs "critere")) :test #'equal))) "observations_dupliquees")
              (let ((tentative (objet "id" (mrjam-native:aleatoire-url) "production" (j p "production")
                  "production_origine" "eleve_rapportee" "auteur_trace" acteur "canal" canal
                  "interpretation_origine" (if (equal canal "mcp") "llm" "eleve")
                  "activite_version" (prescription-version a) "politique_version" 1 "activite_a" (j p "activite_a")
                  "recu_a" temps "fuseau" "UTC" "aides" (tableau aides) "observations" (tableau observations))))
                (contexte-seance base (sauver base o (remplacer s "tentatives" (tableau (append tentatives (list tentative)))) acteur temps) r temps p))))
           ((equal nom "transition")
            (let ((action (j p "action")) (etat (j s "etat")) (tentatives (elements (j s "tentatives"))))
              (exiger (member action '("reprendre" "interrompre" "terminer") :test #'equal) "action_invalide")
              (exiger (if (equal action "reprendre") (equal etat "interrompue") (equal etat "en_cours")) "transition_interdite" 409)
              (when (equal action "terminer")
                (exiger (= (prescription-version a) (j s "activite_version")) "contexte_modifie" 409)
                (exiger tentatives "seance_incomplete" 409)
                (let ((obs (dernieres-observations s)))
                  (exiger (every (lambda (c) (let ((o (find (j c "id") obs :key (lambda (x) (j x "critere")) :test #'equal)))
                    (and o (= (j o "activite_version") (j s "activite_version"))
                         (not (equal (j o "etat") "non_observe")))))
                    (elements (j (version base (j a "id") (prescription-version a)) "criteres"))) "criteres_non_observes" 409)))
              (exiger (< (length (elements (j s "transitions"))) 256) "limite_transitions_atteinte" 409)
              (contexte-seance base (sauver base o (remplacer s "etat" (cond ((equal action "reprendre") "en_cours")
                    ((equal action "terminer") "terminee") (t "interrompue"))
                  "reprise_a" (if (equal action "reprendre") temps (j s "reprise_a"))
                  "transitions" (tableau (append (elements (j s "transitions"))
                    (list (objet "action" action "auteur" acteur "recu_a" temps "fuseau" "UTC"))))) acteur temps) r temps p)))
           ((equal nom "rectifier")
            (let* ((tentative (find (j p "tentative") (elements (j s "tentatives")) :key (lambda (x) (j x "id")) :test #'equal))
                   (critere (and tentative (find (j p "observation") (elements (j tentative "observations")) :key (lambda (x) (j x "critere")) :test #'equal))))
              (exiger (and critere (texte-p (j p "justification") 4000)
                           (or (j p "etat") (texte-p (j p "annotation") 4000))) "rectification_invalide")
              (when (j p "etat")
                (observer (objet "critere" (j p "observation") "etat" (j p "etat") "points" (or (j p "points") :null)
                                "justification" (j p "justification"))
                          (version base (j a "id") (j tentative "activite_version")) (elements (j tentative "aides")) temps))
              (exiger (< (length (elements (j s "rectifications"))) 256) "limite_rectifications_atteinte" 409)
              (contexte-seance base (sauver base o (remplacer s "rectifications" (tableau (append (elements (j s "rectifications"))
                 (list (objet "id" (mrjam-native:aleatoire-url) "tentative" (j tentative "id") "critere" (j p "observation")
                    "etat" (or (j p "etat") :null) "points" (or (j p "points") :null)
                    "annotation" (or (j p "annotation") :null) "justification" (j p "justification")
                    "auteur" acteur "recu_a" temps "fuseau" "UTC"))))) acteur temps) r temps p))))))
      ((equal nom "rapport")
       (let* ((affectations (lister base groupe "affectation")) (sessions (lister base groupe "seance"))
              (eleves (remove-if-not (lambda (m) (equal (j m "role") "eleve")) (membres base groupe)))
              (versions (make-hash-table :test #'equal)) (lignes nil))
         (when (j p "activite")
           (setf affectations (remove-if-not (lambda (a) (equal (j (j a "document") "activite") (j p "activite"))) affectations)))
         (exiger (<= (* (length affectations) (length eleves)) 10000) "rapport_trop_large_preciser_activite" 409)
         (dolist (aff affectations)
           (when (or (not (j p "activite")) (equal (j (j aff "document") "activite") (j p "activite")))
             (let ((a (charger base (j (j aff "document") "activite") groupe "activite")))
               (dolist (eleve eleves)
                 (let* ((id (j eleve "acteur"))
                        (s (find-if (lambda (s) (and (equal (j (j s "document") "affectation") (j aff "id"))
                                                     (equal (j (j s "document") "eleve") id))) sessions))
                        (v (if s (j (j s "document") "activite_version") (j (j aff "document") "activite_version")))
                        (cle-version (list (j a "id") v))
                        (doc (or (gethash cle-version versions) (setf (gethash cle-version versions) (version base (j a "id") v))))
                        (obs (and s (remove-if-not (lambda (o) (= v (j o "activite_version"))) (dernieres-observations (j s "document"))))))
                   (when (and (member id (elements (j (j aff "document") "eleves")) :test #'equal)
                              (or (not (j p "eleve")) (equal id (j p "eleve"))))
                     (push (objet "eleve" id "affectation" (j aff "id") "activite" (j a "id") "titre" (j doc "titre")
                       "activite_version" v "echeance" (j (j aff "document") "echeance")
                       "seance" (if s (presenter s (remplacer (j s "document") "tentatives" (vision:jarray))) :null)
                       "attendus" (j doc "attendus") "criteres" (j doc "criteres")
                       "observations" (tableau obs) "etat" (if s (j (j s "document") "etat") "non_observe")
                       "tentatives" (if s (or (j (j s "document") "total_tentatives") 0) 0)) lignes)))))))
         (let* ((ordonnee (nreverse lignes)) (indicateurs (indicateurs-rapport ordonnee base)))
           (remplacer (paginer ordonnee p) "methode" "Dernière interprétation par séance et critère, rectifications attribuées. Versions et aides conservées ; aucune moyenne logarithmique."
             "indicateurs" (paginer (elements indicateurs) p)
             "difficultes" (tableau (remove-if-not (lambda (i) (plusp (j i "difficultes"))) (elements indicateurs)))))))
      (t (refuser "operation_inconnue" 404)))))

(defun appeler (service acteur nom p &key (canal "web"))
  "Acteur vérifié par le serveur central, jamais par un paramètre du navigateur/LLM."
  (exiger (acteur-p acteur) "identite_requise" 401)
  (let ((definition (definition nom)))
    (champs p (third definition) (fourth definition)))
  (when (j p "groupe") (exiger (identifiant-p (j p "groupe")) "groupe_invalide"))
  (when (ecriture-p nom) (exiger (and (identifiant-p (j p "cle")) (>= (length (j p "cle")) 16)) "cle_idempotence_requise"))
  (avec-depot (service-depot service) acteur (j p "groupe")
    (lambda (base)
      (let* ((r (autoriser base acteur nom p)) (temps (funcall (service-horloge service)))
             (empreinte (when (ecriture-p nom) (mrjam-native:sha256
                        (vision:json-encode (objet "canal" canal "parametres" (canonique p))))))
             (rejeu (when (ecriture-p nom) (requete-idempotente base acteur (j p "cle")))))
        ;; Autorisation de la ressource même pour un rejeu. Un droit révoqué ne
        ;; permet pas de récupérer une ancienne réponse contenant des traces.
        (when (member nom '("adopter_contexte" "consigner" "transition" "rectifier") :test #'equal)
          (seance-propre base acteur p r))
        (when rejeu
          (exiger (and (equal nom (j rejeu "operation")) (equal empreinte (j rejeu "empreinte"))) "cle_reutilisee_avec_autre_operation" 409)
          (return-from appeler (copier (j rejeu "resultat"))))
        (let ((resultat (effectuer base acteur nom p r temps canal)))
          (when (ecriture-p nom) (retenir-requete base acteur (j p "cle")
                     (unless (equal nom "supprimer_groupe") (j p "groupe")) nom empreinte resultat temps))
          resultat)))))
