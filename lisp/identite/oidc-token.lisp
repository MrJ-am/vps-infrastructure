(in-package #:mrjam-oidc)

(define-condition oidc-error (error)
  ((raison :initarg :raison :reader oidc-error-raison))
  (:report (lambda (condition stream)
             ;; Aucun JWT, nonce, claim personnel ou contenu de réponse ici.
             (format stream "Identité OIDC refusée (~A)." (oidc-error-raison condition)))))

(defun refuser (raison) (error 'oidc-error :raison raison))
(defstruct (identite (:constructor %identite)) issuer sujet expiration auth-time claims)
(defmethod print-object ((objet identite) stream)
  (print-unreadable-object (objet stream :type t)
    (write-string "claims personnels masqués" stream)))

(defun texte-borne-p (valeur minimum maximum)
  (and (stringp valeur) (<= minimum (length valeur) maximum)
       (every (lambda (c) (<= 32 (char-code c) #x10ffff)) valeur)))

(defun identifiant-client-p (valeur)
  (and (texte-borne-p valeur 1 128)
       (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                             (char<= #\0 c #\9) (find c "_-"))) valeur)))

(defun issuer-client (client-id)
  (unless (identifiant-client-p client-id) (refuser :client))
  (concatenate 'string "https://log.mrj.am/oauth2/openid/" client-id))

(defun discovery-client (client-id)
  (concatenate 'string (issuer-client client-id) "/.well-known/openid-configuration"))

(defun verifier-discovery (document client-id)
  "Profil Kanidm fermé ; le document doit provenir du transport HTTPS de confiance.
Cette validation n'effectue pas de requête ni d'enregistrement dynamique de client."
  (unless (vision:json-object-p document) (refuser :discovery))
  (let ((issuer (issuer-client client-id)))
    (dolist (champ (list (cons "issuer" issuer)
                        (cons "authorization_endpoint" "https://log.mrj.am/ui/oauth2")
                        (cons "token_endpoint" "https://log.mrj.am/oauth2/token")
                        (cons "jwks_uri" (concatenate 'string issuer "/public_key.jwk"))))
      (unless (equal (cdr champ) (vision:json-object-get document (car champ)))
        (refuser :discovery-endpoint)))
    (dolist (champ '(("response_types_supported" . "code")
                    ("id_token_signing_alg_values_supported" . "ES256")
                    ("code_challenge_methods_supported" . "S256")
                    ("token_endpoint_auth_methods_supported" . "client_secret_basic")))
      (let* ((tableau (vision:json-object-get document (car champ)))
             (valeurs (and (vision:json-array-p tableau) (vision:json-array-items tableau))))
        (unless (and valeurs (<= (length valeurs) 32) (every #'stringp valeurs)
                     (member (cdr champ) valeurs :test #'equal))
          (refuser :discovery-profil))))
    t))

(defun decoder-url (texte maximum)
  (unless (and (stringp texte) (<= 1 (length texte) maximum)
               (/= (mod (length texte) 4) 1)
               (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                                     (char<= #\0 c #\9) (find c "_-"))) texte))
    (refuser :base64url))
  (let* ((remplissage (mod (- (length texte)) 4))
         (octets (cl-base64:base64-string-to-usb8-array
                   ;; Le mode URI de cette révision utilise « . » en interne
                   ;; comme remplissage ; le JWT reçu ne peut en contenir aucun.
                   (concatenate 'string texte (make-string remplissage :initial-element #\.))
                   :uri t :whitespace :error)))
    (unless (equal texte (mrjam-native:base64 octets :url t :sans-remplissage t))
      (refuser :base64url-non-canonique))
    octets))

(defun objet-json-borne (octets)
  (let ((texte (sb-ext:octets-to-string octets :external-format :utf-8))
        (profondeur 0) (chaine nil) (echappe nil))
    ;; Borne avant le parseur récursif existant, sans interpréter le JSON deux fois.
    (loop for c across texte do
      (cond (echappe (setf echappe nil))
            ((and chaine (char= c #\\)) (setf echappe t))
            ((char= c #\") (setf chaine (not chaine)))
            ((not chaine)
             (cond ((find c "{[") (incf profondeur)
                    (when (> profondeur 16) (refuser :profondeur-json)))
                   ((find c "}]") (decf profondeur))))))
    (let ((objet (vision:parse-json texte)))
      (unless (vision:json-object-p objet) (refuser :objet-json))
      objet)))

(defun membre (objet cle) (vision:json-object-get objet cle))

(defun entier-requis (objet cle)
  (let ((valeur (membre objet cle)))
    (unless (and (integerp valeur) (<= 0 valeur #x1fffffffffffff))
      (refuser :date))
    valeur))

(defun chaine-requise (objet cle maximum)
  (let ((valeur (membre objet cle)))
    (unless (texte-borne-p valeur 1 maximum) (refuser :claim-texte)) valeur))

(defun cle-es256 (jwks kid)
  ;; JWKS fourni par la récupération de confiance, jamais par un en-tête jku/jwk.
  (unless (vision:json-object-p jwks) (refuser :jwks))
  (let* ((tableau (membre jwks "keys"))
         (cles (and (vision:json-array-p tableau) (vision:json-array-items tableau))))
    (unless (and cles (<= (length cles) 32) (every #'vision:json-object-p cles))
      (refuser :jwks))
    (let ((choix (remove-if-not (lambda (cle) (equal kid (membre cle "kid"))) cles)))
      (unless (= (length choix) 1) (refuser :kid))
      (let* ((cle (first choix)) (operations (membre cle "key_ops")))
        (unless (and (equal "EC" (membre cle "kty"))
                     (equal "P-256" (membre cle "crv"))
                     (or (null (membre cle "alg")) (equal "ES256" (membre cle "alg")))
                     (or (null (membre cle "use")) (equal "sig" (membre cle "use")))
                     (or (null operations)
                         (and (vision:json-array-p operations)
                              (equal '("verify") (vision:json-array-items operations))))
                     (not (nth-value 1 (vision:json-object-get cle "d"))))
          (refuser :cle))
        (let ((x (decoder-url (membre cle "x") 43)) (y (decoder-url (membre cle "y") 43)))
          (unless (and (= (length x) 32) (= (length y) 32)
                       (< (ironclad:octets-to-integer x :big-endian t) ironclad::+secp256r1-p+)
                       (< (ironclad:octets-to-integer y :big-endian t) ironclad::+secp256r1-p+))
            (refuser :coordonnees))
          (ironclad:make-public-key :secp256r1
            :y (concatenate '(simple-array (unsigned-byte 8) (*)) #(4) x y)))))))

(defun signature-valide-p (cle entree signature)
  ;; Les méthodes amont safety0 reçoivent uniquement les formes/domaines attendus.
  (unless (and (= (length signature) 64)
               (< 0 (ironclad:octets-to-integer signature :end 32 :big-endian t)
                  ironclad::+secp256r1-l+)
               (< 0 (ironclad:octets-to-integer signature :start 32 :big-endian t)
                  ironclad::+secp256r1-l+))
    (refuser :signature))
  (ironclad:verify-signature cle
    (mrjam-native::digest-octets (mrjam-native::octets entree)) signature))

(defun audience-valide-p (claims client-id)
  (let* ((aud (membre claims "aud"))
         (audiences (cond ((stringp aud) (list aud))
                          ((vision:json-array-p aud) (vision:json-array-items aud)))))
    (unless (and audiences (<= (length audiences) 16)
                 (every (lambda (a) (texte-borne-p a 1 128)) audiences)
                 (= (length audiences) (length (remove-duplicates audiences :test #'equal)))
                 (member client-id audiences :test #'equal)
                 (or (= (length audiences) 1) (equal client-id (membre claims "azp")))
                 (or (not (nth-value 1 (vision:json-object-get claims "azp")))
                     (equal client-id (membre claims "azp"))))
      (refuser :audience))))

(defun %verifier-id-token (token jwks client-id nonce maintenant tolerance max-age access-token)
  (unless (and (identifiant-client-p client-id) (texte-borne-p nonce 16 256)
               (integerp maintenant) (<= 0 maintenant #x1fffffffffffff)
               (integerp tolerance) (<= 0 tolerance 30)
               (or (null max-age) (and (integerp max-age) (<= 0 max-age (* 90 86400))))
               (or (null access-token) (texte-borne-p access-token 1 16384))
               (stringp token) (<= 1 (length token) 16384))
    (refuser :parametres))
  (let ((parties (uiop:split-string token :separator ".")))
    (unless (= (length parties) 3) (refuser :compact-jws))
    (let* ((header (objet-json-borne (decoder-url (first parties) 2048)))
           (kid (chaine-requise header "kid" 256)))
      ;; Profil explicite : aucune résolution d'URL, clé injectée ni extension.
      (unless (and (equal "ES256" (membre header "alg"))
                   (or (not (nth-value 1 (vision:json-object-get header "typ")))
                       (equal "JWT" (membre header "typ")))
                   (every (lambda (entry) (member (car entry) '("alg" "kid" "typ") :test #'equal))
                          (vision:json-object-entries header)))
        (refuser :header))
      (let ((cle (cle-es256 jwks kid))
            (signature (decoder-url (third parties) 86)))
        (unless (signature-valide-p cle
                  (concatenate 'string (first parties) "." (second parties)) signature)
          (refuser :signature)))
      (let* ((claims (objet-json-borne (decoder-url (second parties) 12288)))
             (iss (chaine-requise claims "iss" 256))
             (sub (chaine-requise claims "sub" 128))
             (exp (entier-requis claims "exp")) (iat (entier-requis claims "iat"))
             (auth-time (membre claims "auth_time")))
        (unless (equal iss (issuer-client client-id)) (refuser :issuer))
        (audience-valide-p claims client-id)
        (unless (and (> exp (- maintenant tolerance)) (> exp iat)
                     (<= iat (+ maintenant tolerance))) (refuser :expiration))
        (when (nth-value 1 (vision:json-object-get claims "nbf"))
          (unless (<= (entier-requis claims "nbf") (+ maintenant tolerance))
            (refuser :pas-encore-valide)))
        (unless (and (texte-borne-p (membre claims "nonce") 16 256)
                     (mrjam-native:secret-egal-p nonce (membre claims "nonce")))
          (refuser :nonce))
        (when (or max-age (nth-value 1 (vision:json-object-get claims "auth_time")))
          (setf auth-time (entier-requis claims "auth_time"))
          (unless (and (<= auth-time (+ maintenant tolerance))
                       (<= auth-time (+ iat tolerance))
                       (or (null max-age) (<= (- maintenant auth-time) (+ max-age tolerance))))
            (refuser :fraicheur)))
        (when (nth-value 1 (vision:json-object-get claims "at_hash"))
          (unless access-token (refuser :access-token-manquant))
          (let ((attendu (mrjam-native:base64
                           (subseq (mrjam-native::digest-octets (mrjam-native::octets access-token)) 0 16)
                           :url t :sans-remplissage t)))
            (unless (and (stringp (membre claims "at_hash"))
                         (mrjam-native:secret-egal-p attendu (membre claims "at_hash")))
              (refuser :at-hash))))
        (%identite :issuer iss :sujet sub :expiration exp :auth-time auth-time :claims claims)))))

(defun verifier-id-token (token jwks &key client-id nonce maintenant (tolerance 30) max-age access-token)
  "JWKS de confiance, client et nonce issus de la transaction serveur durable.
Ne crée pas de session, ne mappe pas une adresse et ne prouve pas une méthode MFA.
L'appelant conserve state/PKCE, consomme sa transaction une seule fois et vérifie
la révocation indépendamment. Dates : secondes UNIX ; aucune lecture réseau ici."
  (handler-case (%verifier-id-token token jwks client-id nonce maintenant tolerance max-age access-token)
    (oidc-error (condition) (error condition))
    (error () (refuser :invalide))))
