(in-package #:mrjam-identite)
(defstruct (client-kanidm-runtime (:constructor %client-kanidm) (:predicate client-kanidm-p)
                                 (:conc-name client-kanidm-)) token curl ca port enregistrer)
(defmethod print-object ((c client-kanidm-runtime) s)
  (print-unreadable-object (c s :type t) (write-string "capacité admission masquée" s)))
(defun faire-client-kanidm (token curl ca &key (port 8443) enregistrer)
  (unless (and (mrjam-courriel::ascii-p token "_.-" 32 16384)
               (mrjam-oidc::fichier-transport-p curl) (mrjam-oidc::fichier-transport-p ca)
               (integerp port) (<= 1 port 65535) (or (not enregistrer) (functionp enregistrer))) (refuse))
  (%client-kanidm :token token :curl curl :ca ca :port port :enregistrer enregistrer))
(defun enregistrer-principal (c id mail)
  (when (client-kanidm-enregistrer c) (funcall (client-kanidm-enregistrer c) id mail)))
(defun api-personnes (c method path &optional document)
  "Capacité native d'onboarding seulement ; aucun endpoint de groupe/politique.
Pas de POST répété sur timeout, pas de secret dans argv, aucun fallback HTTP."
  (unless (and (client-kanidm-p c) (member method '("GET" "POST" "PUT" "DELETE") :test #'equal)
               (or (equal path "/v1/person") (uiop:string-prefix-p "/v1/person/" path))
               (mrjam-courriel::ascii-p path "/_.-" 1 512)) (refuse))
  (let ((p nil))
    (unwind-protect
      (sb-ext:with-timeout 15
        (setf p (sb-ext:run-program (client-kanidm-curl c) '("--disable" "--config" "-")
                   :input :stream :output :stream :error nil :wait nil :external-format :utf-8))
        (let ((o (sb-ext:process-input p)))
          (format o "silent~%show-error~%max-time = 10~%connect-timeout = 5~%proxy = \"\"~%proto = \"=https\"~%tlsv1.2~%max-filesize = 1048576~%write-out = \"\\n%{response_code}\"~%")
          (flet ((opt (k v) (format o "~A = ~A~%" k (mrjam-courriel::config-curl v))))
            (opt "url" (concatenate 'string "https://log.mrj.am" path))
            (opt "connect-to" (format nil "log.mrj.am:443:127.0.0.1:~D" (client-kanidm-port c)))
            (opt "cacert" (client-kanidm-ca c)) (opt "request" method)
            (opt "header" (concatenate 'string "Authorization: Bearer " (client-kanidm-token c)))
            (opt "header" "Expect:")
            (when document (opt "header" "Content-Type: application/json") (opt "data" (mrjam-native:json-js document))))
          (finish-output o) (close o))
        (let* ((buffer (make-array 1048582 :element-type 'character))
               (n (read-sequence buffer (sb-ext:process-output p))))
          (sb-ext:process-wait p)
          (unless (and (= 0 (sb-ext:process-exit-code p)) (<= 4 n) (< n (length buffer))
                       (char= #\Newline (aref buffer (- n 4)))) (refuse))
          (let ((code (parse-integer buffer :start (- n 3) :end n)))
            (unless (= code 200) (refuse))
            (when (> n 4) (vision:parse-json (subseq buffer 0 (- n 4)))))))
      (when p (when (sb-ext:process-alive-p p) (sb-ext:process-kill p sb-posix:sigkill)) (sb-ext:process-close p)))))
(defun chemin-personne (id &optional (suffix ""))
  (unless (mrjam-courriel::ascii-p id "_-" 1 128) (refuse))
  (concatenate 'string "/v1/person/" id suffix))
(defun valeurs-natives (a k)
  (let ((v (vision:json-object-get a k))) (when (vision:json-array-p v) (vision:json-array-items v))))
(defun date-native (s)
  ;; Le sérialiseur Datetime Kanidm normalise en UTC. Refus explicite d'un
  ;; format inconnu, jamais une date de suspension interprétée comme active.
  (unless (and (stringp s) (>= (length s) 20)
               (char= #\- (char s 4)) (char= #\- (char s 7)) (char= #\T (char s 10))
               (char= #\: (char s 13)) (char= #\: (char s 16))
               (or (uiop:string-suffix-p s "Z") (uiop:string-suffix-p s "+00:00"))) (refuse))
  (handler-case
      (encode-universal-time (parse-integer s :start 17 :end 19) (parse-integer s :start 14 :end 16)
        (parse-integer s :start 11 :end 13) (parse-integer s :start 8 :end 10)
        (parse-integer s :start 5 :end 7) (parse-integer s :start 0 :end 4) 0)
    (error () (refuse))))
(defun personne (c id)
  (let* ((d (api-personnes c "GET" (chemin-personne id)))
         (a (vision:json-object-get d "attrs")))
    (when (and a (not (eq d :null)))
      (flet ((v (k) (first (valeurs-natives a k))))
        (vision:jobject "id" (v "uuid") "username" (v "name") "email" (v "mail")
          ;; La mail n'est modifiable qu'en dehors du libre-service par défaut.
          ;; La vérification d'adresse est assurée par l'admission avant création.
          "emailVerified" (if (v "mail") :true :false)
          "enabled" (if (and (or (not (v "account_expire")) (> (date-native (v "account_expire")) (get-universal-time)))
                             (or (not (v "account_valid_from")) (<= (date-native (v "account_valid_from")) (get-universal-time))))
                         :true :false))))))
(defun chercher-personnes (c key value)
  (unless (member key '("email" "username") :test #'equal) (refuse))
  (let ((rows (vision:json-array-items (api-personnes c "GET" "/v1/person"))))
    (when (> (length rows) 2048) (refuse))
    (loop for d in rows for a = (vision:json-object-get d "attrs")
          for v = (first (valeurs-natives a (if (equal key "email") "mail" "name")))
          when (and v (string-equal v value))
          collect (personne c (first (valeurs-natives a "uuid"))))))
(defun creer-personne (c nom mail affichage)
  (api-personnes c "POST" "/v1/person" (vision:jobject "attrs" (vision:jobject
    "name" (vision:jarray nom) "mail" (vision:jarray mail)
    "displayname" (vision:jarray (or affichage mail))
    "account_expire" (vision:jarray "1970-01-01T00:00:00Z"))))
  (or (personne c nom) (refuse)))
(defun activer-personne (c id)
  (api-personnes c "DELETE" (chemin-personne id "/_attr/account_expire")) t)
(defun inviter-personne (c id)
  (let* ((d (api-personnes c "GET" (chemin-personne id "/_credential/_update_intent/600")))
         (token (vision:json-object-get d "token")))
    (unless (and (stringp token) (<= 1 (length token) 2048)) (refuse))
    (concatenate 'string "https://log.mrj.am/ui/reset?token=" (parametre-url token))))
(defun expirer-personne (c id)
  (api-personnes c "PUT" (chemin-personne id "/_attr/account_expire") (vision:jarray "1970-01-01T00:00:00Z"))
  ;; L'identité est inutilisable, ses secrets retirés. Le recyclage définitif
  ;; IdP reste une opération distincte, jamais une cascade de données métier.
  (dolist (attr '("primary_credential" "passkeys" "attested_passkeys"))
    (api-personnes c "DELETE" (chemin-personne id (concatenate 'string "/_attr/" attr)))) t)
