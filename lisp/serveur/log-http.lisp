(in-package #:mrjam-metier)

(defun log-json (s status value &optional headers)
  (repondre-http s status (if (= status 204) "" (mrjam-native:json-js value))
    (append headers '(("Cache-Control" . "no-store") ("Referrer-Policy" . "no-referrer")
                      ("X-Content-Type-Options" . "nosniff")))))

(defun router-log (contexte s method target headers body)
  "Uniquement sur le socket privé et le service fixé par Nginx, jamais un listener public."
  (let* ((hote (entete headers "x-forwarded-host"))
         (q (position #\? target)) (path (subseq target 0 q))
         (query (decode-query (and q (subseq target (1+ q)))))
         (cookies (entete headers "cookie")))
    (unless (and contexte (equal (entete headers "x-forwarded-proto") "https")) (erreur-http 503))
    (flet ((redirection (url &rest entetes)
             (log-json s 302 (vision:jobject) (cons (cons "Location" url) entetes)))
           (csrf (session)
             (unless (mrjam-log:csrf-valide-p session (entete headers "origin") hote (entete headers "x-csrf-token"))
               (erreur-http 403)))
           (document (type)
             (unless (and (<= 1 (length body) 8192)
                          (equal (first (uiop:split-string (or (entete headers "content-type") "") :separator ";")) type))
               (erreur-http 415))
             (if (equal type "application/json") (vision:parse-json body) (decode-query body))))
      (handler-case
          (cond
            ((and (equal method "GET")
                  (member path '("/.well-known/oauth-authorization-server" "/.well-known/oauth-protected-resource"
                                 "/.well-known/oauth-protected-resource/mcp") :test #'equal))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (log-json s 200 (mrjam-log::metadata-mcp (not (equal path "/.well-known/oauth-authorization-server")))))
            ((and (equal method "POST") (equal path "/oauth/register"))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (log-json s 201 (mrjam-log::enregistrer-client contexte (document "application/json"))))
            ((and (equal method "POST") (equal path "/oauth/token"))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (log-json s 200 (mrjam-log::jetons-mcp contexte (document "application/x-www-form-urlencoded"))))
            ((and (equal method "POST") (equal path "/oauth/revoke"))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (let ((p (document "application/x-www-form-urlencoded")))
               (mrjam-log::revoquer-mcp contexte (vision:json-object-get p "client_id") (vision:json-object-get p "token")))
             (log-json s 200 (vision:jobject)))
            ((and (equal method "GET") (equal path "/verify-mcp"))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (let ((username (mrjam-log::verifier-mcp contexte (entete headers "authorization"))))
               (unless username (erreur-http 401))
               (log-json s 204 (vision:jobject) (list (cons "X-Mrj-User" username)))))
            ((and (equal method "GET") (equal path "/oauth/authorize"))
             (unless (equal hote "vision.mrj.am") (erreur-http 403))
             (if (mrjam-log:session contexte hote cookies)
                 (redirection (concatenate 'string "/#autorisation-mcp=" (mrjam-log::demander-mcp contexte cookies query)))
                 (redirection (concatenate 'string "/auth/connexion?retour=" (mrjam-native:parametre-url target)))))
            ((and (equal method "GET") (equal path "/auth/connexion"))
             (multiple-value-bind (url cookie) (mrjam-log:demarrer contexte hote (or (vision:json-object-get query "retour") "/"))
               (redirection url (cons "Set-Cookie" cookie))))
            ((and (equal method "GET") (equal path "/auth/retour"))
             (multiple-value-bind (url cookie suppression) (mrjam-log:retour contexte hote
                 (vision:json-object-get query "state") (vision:json-object-get query "code") cookies)
               (redirection url (cons "Set-Cookie" cookie) (cons "Set-Cookie" suppression))))
            ((and (equal method "GET") (equal path "/auth/configuration"))
             (mrjam-log::client contexte hote)
             (log-json s 200 (vision:jobject "mode" "oidc" "connexion" "/auth/connexion"
                                             "compte" "https://log.mrj.am/ui/profile")))
            (t
             (let* ((session (mrjam-log:session contexte hote cookies))
                    (username (mrjam-log::champ session "username"))
                    (compte (mrjam-log::champ session "compte")))
               (unless session (erreur-http 401))
               (cond
                 ((and (equal method "GET") (equal path "/auth/oauth-demande"))
                  (unless (equal hote "vision.mrj.am") (erreur-http 403))
                  (log-json s 200 (mrjam-log::lire-demande-mcp contexte cookies (vision:json-object-get query "id"))))
                 ((and (equal method "POST") (equal path "/auth/oauth-consentement"))
                  (unless (equal hote "vision.mrj.am") (erreur-http 403))
                  (csrf session)
                  (let* ((p (document "application/json")) (decision (vision:json-object-get p "decision")))
                    (unless (member decision '("autoriser" "refuser") :test #'equal) (erreur-http 400))
                    (log-json s 200 (vision:jobject "redirection" (mrjam-log::consentir-mcp contexte cookies
                      (vision:json-object-get p "id") (equal decision "autoriser"))))))
                 ((and (equal method "GET") (equal path "/verify"))
                  (unless (member (entete headers "x-original-method") '("GET" "HEAD") :test #'equal) (csrf session))
                  (log-json s 204 (vision:jobject) (list (cons "X-Mrj-User" username))))
                 ((and (equal method "GET") (equal path "/auth/session"))
                  (log-json s 200 (vision:jobject "username" username
                        "csrf" (mrjam-log::champ session "csrf") "expiresAt" (mrjam-log::champ session "expiresAt")
                        "administrateur" (if (eq :true (vision:json-object-get compte "administrateur")) :true :false)
                        ;; Absence amr/acr : ne pas inventer une preuve MFA.
                        "verificationRenforcee" :false)))
                 ((and (equal method "POST") (equal path "/auth/logout"))
                  (csrf session)
                  (log-json s 200 (vision:jobject "signedOut" :true)
                    (list (cons "Set-Cookie" (mrjam-log:deconnecter contexte hote cookies)))))
                 ((and (equal method "POST") (equal path "/auth/revoquer-autres"))
                  (csrf session) (mrjam-log:revoquer-autres contexte hote cookies)
                  (log-json s 200 (vision:jobject "sessionsApplicativesRevoquees" :true)))
                 (t (erreur-http 404))))))
        (mrjam-log:log-error (e) (erreur-http (mrjam-log:statut-erreur e)))
        (mrjam-oidc:oidc-error () (erreur-http 401))))))
