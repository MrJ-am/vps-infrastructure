(in-package #:mrjam-metier)

(defun router-audition (service log s methode target headers corps)
  "Nginx fixe le service sur le socket privé. L'identité est vérifiée via Log
pour CHAQUE appel, même discovery/lecture de séance. Aucun rôle dans les paramètres."
  (let* ((q (position #\? target)) (path (subseq target 0 q))
         (hote (entete headers "x-forwarded-host"))
         (mrjam-log::*hote-mcp* "audition.mrj.am"))
    (unless (and service log (equal hote "audition.mrj.am")
                 (equal (entete headers "x-forwarded-proto") "https")) (erreur-http 503))
    (labels ((reply (status doc &optional extra)
               (repondre-http s status (if (stringp doc) doc (mrjam-native:json-js doc))
                 (append extra '(("Cache-Control" . "no-store") ("X-Content-Type-Options" . "nosniff")
                   ("Referrer-Policy" . "no-referrer")))))
             (auth ()
               (let* ((session (if (equal path "/mcp")
                          (mrjam-log::session-mcp log (entete headers "authorization"))
                          (mrjam-log:session log hote (entete headers "cookie"))))
                      (acteur (mrjam-log::champ session "username")))
                 (unless acteur
                   (reply 401 (vision:jobject "erreur" "session_expiree" "connexion" "/auth/connexion")
                     (when (equal path "/mcp")
                       '(("WWW-Authenticate" . "Bearer resource_metadata=\"https://audition.mrj.am/.well-known/oauth-protected-resource/mcp\""))))
                   (return-from router-audition))
                 (values acteur session))))
      (handler-case
        (multiple-value-bind (acteur session) (auth)
          (when q (erreur-http 400))
          (unless (equal methode "POST") (erreur-http 405))
          (unless (equal (first (uiop:split-string (or (entete headers "content-type") "") :separator ";")) "application/json") (erreur-http 415))
          (unless (<= 1 (length (sb-ext:string-to-octets corps :external-format :utf-8)) 65536) (erreur-http 413))
          (let* ((document (vision:parse-json corps))
                 (operation (if (equal path "/mcp")
                              (vision:json-object-get (vision:json-object-get document "params") "name")
                              (when (uiop:string-prefix-p "/api/audition/" path) (subseq path 14)))))
            (when (and (member operation '("creer_groupe" "habiliter" "supprimer_groupe") :test #'equal)
                       (not (mrjam-log::verification-renforcee-p log session)))
              (reply 403 (vision:jobject "erreur" "verification_renforcee_requise"
                        "connexion" "/auth/connexion?verification=renforcee&retour=%2F%23administration"))
              (return-from router-audition)))
          (unless (equal path "/mcp")
            (let ((session (mrjam-log:session log hote (entete headers "cookie"))))
              (unless (mrjam-log:csrf-valide-p session (entete headers "origin") hote (entete headers "x-csrf-token")) (erreur-http 403))))
          (if (equal path "/mcp")
              (progn
                (when (and (entete headers "origin") (not (equal (entete headers "origin") "https://audition.mrj.am"))) (erreur-http 403))
                (multiple-value-bind (status raison resultat) (mrjam-audition:mcp service acteur corps)
                  (declare (ignore raison)) (reply status (or resultat ""))))
              (progn
                (unless (uiop:string-prefix-p "/api/audition/" path) (erreur-http 404))
                (reply 200 (mrjam-audition:appeler service acteur (subseq path 14) (vision:parse-json corps))))))
        (mrjam-audition:audition-error (e)
          (reply (mrjam-audition:statut-erreur e) (vision:jobject "erreur" (mrjam-audition:code-erreur e)
                   "details" (or (mrjam-audition:details-erreur e) :null))))
        (mrjam-log:log-error (e) (reply (mrjam-log:statut-erreur e) (vision:jobject "erreur" "identite_indisponible")))
        (mrjam-oidc:oidc-error () (reply 401 (vision:jobject "erreur" "session_expiree")))
        (vision::json-error () (reply 400 (vision:jobject "erreur" "json_invalide")))
        (mrjam-native:database-error (e)
          (reply (if (member (mrjam-native:sqlstate e) '("23505" "40001") :test #'equal) 409 503)
            (vision:jobject "erreur" (if (member (mrjam-native:sqlstate e) '("23505" "40001") :test #'equal) "conflit_revision" "service_indisponible"))))))))
