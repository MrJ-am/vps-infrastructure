(in-package #:mrjam-metier)

(defun requete-presentation-native (contexte chemin methode document cookies &key source-ip)
  "API officielle sur TLS vérifié. Aucun credential opérateur ni répétition.
Les entrées sensibles passent sur stdin, jamais dans argv ou un journal."
  (let ((client (cdar (mrjam-log::contexte-clients contexte))) (processus nil))
    (unless (and client (member methode '("GET" "POST" "DELETE") :test #'equal)
                 (or (null cookies) (and (< (length cookies) 16384)
                   (every (lambda (c) (<= 32 (char-code c) 126)) cookies)))) (erreur-http 400))
    (unwind-protect
        (sb-ext:with-timeout 15
          (setf processus (sb-ext:run-program (mrjam-oidc::client-oidc-curl client)
                            '("--disable" "--config" "-") :input :stream :output :stream
                            :error nil :wait nil :external-format :utf-8))
          (let ((o (sb-ext:process-input processus)))
            (format o "silent~%show-error~%max-time = 10~%proxy = \"\"~%noproxy = \"*\"~%proto = \"=https\"~%tlsv1.2~%max-filesize = 524288~%dump-header = \"-\"~%")
            (flet ((option (k v) (format o "~A = ~A~%" k (mrjam-native:chaine-config-curl v))))
              (option "request" methode)
              (option "url" (concatenate 'string "https://log.mrj.am" chemin))
              (option "connect-to" (format nil "log.mrj.am:443:127.0.0.1:~D" (mrjam-oidc::client-oidc-port client)))
              (when (mrjam-oidc::client-oidc-ca client) (option "cacert" (mrjam-oidc::client-oidc-ca client)))
              (option "header" "Expect:") (option "header" "Origin: https://log.mrj.am")
              (when source-ip
                (unless (and (<= 1 (length source-ip) 46)
                             (every (lambda (c) (find c "0123456789abcdefABCDEF:.")) source-ip)) (erreur-http 400))
                (option "header" (concatenate 'string "X-Forwarded-For: " source-ip)))
              (when cookies (option "header" (concatenate 'string "Cookie: " cookies)))
              ;; Les API OAuth officielles lisent Authorization, contrairement
              ;; aux vues et API utilisateur. Kanidm vérifie ce même jeton ;
              ;; la médiation ne le décode pas et ne le remet pas au navigateur.
              (when (and cookies (uiop:string-prefix-p "/oauth2/authorise" chemin))
                (let ((valeurs (loop for c in (uiop:split-string cookies :separator ";")
                                     for v = (string-trim '(#\Space) c)
                                     when (uiop:string-prefix-p "bearer=" v) collect (subseq v 7))))
                  (unless (= (length valeurs) 1) (erreur-http 401))
                  (option "header" (concatenate 'string "Authorization: Bearer " (first valeurs)))))
              (when document
                (option "header" "Content-Type: application/json")
                (option "data" (mrjam-native:json-js document))))
            (finish-output o) (close o))
          (let* ((tampon (make-array 540672 :element-type 'character))
                 (n (read-sequence tampon (sb-ext:process-output processus)))
                 (texte (subseq tampon 0 n))
                 (fin (search (format nil "~C~C~C~C" #\Return #\Newline #\Return #\Newline) texte)))
            (sb-ext:process-wait processus)
            (unless (and fin (< n (length tampon)) (= 0 (sb-ext:process-exit-code processus))) (erreur-http 502))
            (let* ((lignes (uiop:split-string (subseq texte 0 fin) :separator (string #\Newline)))
                   (status (parse-integer (second (uiop:split-string (first lignes) :separator " "))))
                   (entetes nil))
              (dolist (l (rest lignes))
                (let ((i (position #\: l)))
                  (when i (push (cons (string-downcase (subseq l 0 i))
                        (string-trim '(#\Space #\Return) (subseq l (1+ i)))) entetes))))
              (values status (subseq texte (+ fin 4)) (nreverse entetes)))))
      (when processus
        (when (sb-ext:process-alive-p processus) (sb-ext:process-kill processus sb-posix:sigkill))
        (sb-ext:process-close processus)))))

(defun sujet-presentation-native (contexte cookies)
  "L'identité vient de Kanidm, jamais du corps de requête ou de l'adresse mail."
  (multiple-value-bind (status body) (requete-presentation-native contexte "/v1/self" "GET" nil cookies)
    (unless (= status 200) (erreur-http 401))
    (let* ((p (vision:parse-json body))
           (attrs (vision:json-object-get (vision:json-object-get p "youare") "attrs"))
           (ids (vision:json-object-get attrs "uuid"))
           (items (and (vision:json-array-p ids) (vision:json-array-items ids)))
           (id (and (= (length items) 1) (first items))))
      (unless (vision-administration::uuid-p id) (erreur-http 502)) id)))

(defun chemin-presentation-native (contexte action param cookies)
  (or (cdr (assoc action '(("auth" . "/v1/auth") ("reauth" . "/v1/reauth")
       ("profil" . "/v1/self/_uat") ("applications" . "/v1/self/_applinks")
       ("deconnexion" . "/v1/logout") ("oauth" . "/oauth2/authorise")
       ("consentir" . "/oauth2/authorise/permit") ("refuser" . "/oauth2/authorise/reject")
       ("recuperer" . "/v1/credential/_exchange_intent") ("statut" . "/v1/credential/_status")
       ("modifier" . "/v1/credential/_update") ("enregistrer" . "/v1/credential/_commit")
       ("annuler" . "/v1/credential/_cancel")) :test #'equal))
      (when (member action '("ouvrir" "sessions" "revoquer") :test #'equal)
        (let ((sujet (sujet-presentation-native contexte cookies)))
          (cond ((equal action "ouvrir") (format nil "/v1/person/~A/_credential/_update" sujet))
                ((equal action "sessions") (format nil "/v1/account/~A/_user_auth_token" sujet))
                ((equal action "revoquer")
                 (unless (vision-administration::uuid-p param) (erreur-http 400))
                 (format nil "/v1/account/~A/_user_auth_token/~A" sujet param)))))
      (erreur-http 400)))

(defun router-presentation-log (contexte sortie methode cible headers corps)
  "Médiation bornée ; les politiques et autorisations restent celles de Kanidm."
  (unless (and contexte (equal methode "POST") (equal cible "/presentation/api")
      (equal (entete headers "x-forwarded-host") "log.mrj.am")
      (equal (entete headers "x-forwarded-proto") "https")
      (equal (entete headers "origin") "https://log.mrj.am")
      (equal (entete headers "content-type") "application/json")
      (<= 1 (length corps) 65536)) (erreur-http 403))
  (let* ((p (vision:parse-json corps)) (action (vision:json-object-get p "action"))
         (document (vision:json-object-get p "document")) (cookies (entete headers "cookie"))
         (chemin (chemin-presentation-native contexte action (vision:json-object-get p "parametre") cookies))
         (verbe (cond ((member action '("profil" "applications" "deconnexion" "ouvrir" "sessions") :test #'equal) "GET")
                      ((equal action "revoquer") "DELETE") (t "POST"))))
    (when (equal action "auth")
      (let* ((etape (vision:json-object-get document "step")) (init (vision:json-object-get etape "init2")))
        (when init
          (setf document (vision:jobject "step" (vision:jobject "init2" (vision:jobject
            "username" (nom-connexion-log contexte (vision:json-object-get init "username"))
            "issue" "cookie" "privileged" :false)))))
        ;; Le client ne peut pas demander une session-token ou une élévation initiale.
        (unless (or init (vision:json-object-get etape "begin") (vision:json-object-get etape "cred"))
          (erreur-http 400))))
    (when (equal action "reauth") (setf document "cookie"))
    (multiple-value-bind (status texte entetes)
        (requete-presentation-native contexte chemin verbe (when (equal verbe "POST") document) cookies
                                    :source-ip (entete headers "x-forwarded-for"))
      (let ((resultat (if (and (member action '("oauth" "consentir" "refuser") :test #'equal)
                              (<= 200 status 399) (assoc "location" entetes :test #'equal))
                         (vision:jobject "redirection" (cdr (assoc "location" entetes :test #'equal)))
                         (if (plusp (length texte)) (vision:parse-json texte) :null)))
            (transmis nil) (connecte nil))
        (when (and (member action '("auth" "reauth") :test #'equal) (= status 200))
          (let ((etat (vision:json-object-get resultat "state")))
            (when (vision:json-object-get etat "success")
              (setf connecte t)
              (setf resultat (vision:jobject "state" (vision:jobject "success" ""))))))
        (dolist (h entetes)
          (when (equal (car h) "set-cookie")
            ;; AuthSession de l'API n'a pas de Path : la borner au domaine Log,
            ;; disponible pendant toutes les étapes, jamais dans JavaScript.
            (push (cons "Set-Cookie" (concatenate 'string (cdr h)
                    (if (search "path=" (string-downcase (cdr h))) "" "; Path=/")
                    ;; Persistance navigateur bornée. L'expiration/révocation
                    ;; réelle reste imposée par Kanidm, souvent plus courte.
                    (if (and connecte (uiop:string-prefix-p "bearer=" (cdr h))
                             (not (search "max-age=" (string-downcase (cdr h)))))
                        "; Max-Age=7776000" ""))) transmis)))
        (log-json sortie (if (<= 300 status 399) 200 status) resultat transmis)))))
