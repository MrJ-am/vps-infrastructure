(in-package #:vision)

(define-condition json-error (error)
  ((message :initarg :message :reader json-error-message)))

(defstruct (json-object (:constructor %make-json-object (entries)))
  entries)

(defstruct (json-array (:constructor %make-json-array (items)))
  items)

(defun jobject (&rest pairs)
  (unless (evenp (length pairs))
    (error "JOBJECT expects key/value pairs."))
  (%make-json-object
   (loop for (key value) on pairs by #'cddr
         collect (cons key value))))

(defun jarray (&rest items)
  (%make-json-array items))

(defun json-object-get (object key &optional default)
  (unless (json-object-p object)
    (return-from json-object-get (values default nil)))
  (let ((entry (assoc key (json-object-entries object) :test #'string=)))
    (if entry
        (values (cdr entry) t)
        (values default nil))))

(defun json-fail (message &rest arguments)
  (error 'json-error :message (apply #'format nil message arguments)))

(defun json-whitespace-p (character)
  (find character '(#\Space #\Tab #\Return #\Linefeed) :test #'char=))

(defun parse-json (text)
  (let ((position 0)
        (length (length text)))
    (labels
        ((peek ()
           (and (< position length) (char text position)))
         (take ()
           (prog1 (peek) (incf position)))
         (skip-whitespace ()
           (loop while (and (peek) (json-whitespace-p (peek))) do (incf position)))
         (expect (character)
           (unless (and (peek) (char= (take) character))
             (json-fail "Expected ~S at character ~D." character position)))
         (hex-value (character)
           (or (digit-char-p character 16)
               (json-fail "Invalid Unicode escape at character ~D." position)))
         (read-hex-code-unit ()
           (let ((value 0))
             (loop repeat 4
               do (unless (peek)
                    (json-fail "Incomplete Unicode escape."))
                  (setf value (+ (* value 16) (hex-value (take))))
               finally (return value))))
         (write-code-point (code output)
           (let ((character (code-char code)))
             (unless character
               (json-fail "Unsupported Unicode code point U+~4,'0X." code))
             (write-char character output)))
         (parse-string ()
           (expect #\")
           (with-output-to-string (output)
             (loop
               (unless (peek)
                 (json-fail "Unterminated JSON string."))
               (let ((character (take)))
                 (cond
                   ((char= character #\") (return))
                   ((char= character #\\)
                    (unless (peek)
                      (json-fail "Incomplete JSON escape."))
                    (case (take)
                      (#\" (write-char #\" output))
                      (#\\ (write-char #\\ output))
                      (#\/ (write-char #\/ output))
                      (#\b (write-char #\Backspace output))
                      (#\f (write-char #\Page output))
                      (#\n (write-char #\Newline output))
                      (#\r (write-char #\Return output))
                      (#\t (write-char #\Tab output))
                      (#\u
                       (let ((first (read-hex-code-unit)))
                         (cond
                           ((<= #xD800 first #xDBFF)
                            (unless (and (peek) (char= (take) #\\)
                                         (peek) (char= (take) #\u))
                              (json-fail "High surrogate is not followed by a low surrogate."))
                            (let ((second (read-hex-code-unit)))
                              (unless (<= #xDC00 second #xDFFF)
                                (json-fail "Invalid low surrogate."))
                              (write-code-point
                               (+ #x10000
                                  (* (- first #xD800) #x400)
                                  (- second #xDC00))
                               output)))
                           ((<= #xDC00 first #xDFFF)
                            (json-fail "Unexpected low surrogate."))
                           (t (write-code-point first output)))))
                      (otherwise
                       (json-fail "Invalid JSON escape at character ~D." position))))
                   ((< (char-code character) 32)
                    (json-fail "Control character in JSON string."))
                   (t (write-char character output)))))))
         (parse-literal (literal value)
           (let ((end (+ position (length literal))))
             (unless (and (<= end length)
                          (string= literal text :start2 position :end2 end))
               (json-fail "Invalid JSON literal at character ~D." position))
             (setf position end)
             value))
         (digit-p (character)
           (and character (digit-char-p character 10)))
         (parse-number ()
           (let ((start position)
                 (floating nil))
             (when (and (peek) (char= (peek) #\-))
               (incf position))
             (cond
               ((and (peek) (char= (peek) #\0))
                (incf position)
                (when (digit-p (peek))
                  (json-fail "A JSON number cannot have a leading zero.")))
               ((and (digit-p (peek)) (not (char= (peek) #\0)))
                (loop while (digit-p (peek)) do (incf position)))
               (t (json-fail "Invalid JSON number at character ~D." start)))
             (when (and (peek) (char= (peek) #\.))
               (setf floating t)
               (incf position)
               (unless (digit-p (peek))
                 (json-fail "Missing digits after decimal point."))
               (loop while (digit-p (peek)) do (incf position)))
             (when (and (peek) (find (peek) "eE" :test #'char=))
               (setf floating t)
               (incf position)
               (when (and (peek) (find (peek) "+-" :test #'char=))
                 (incf position))
               (unless (digit-p (peek))
                 (json-fail "Missing exponent digits."))
               (loop while (digit-p (peek)) do (incf position)))
             (let ((token (subseq text start position)))
               (if floating
                   (let ((*read-eval* nil)
                         (*read-default-float-format* 'double-float))
                     (handler-case
                         (read-from-string token)
                       (error () (json-fail "Invalid JSON number."))))
                   (handler-case
                       (parse-integer token :junk-allowed nil)
                     (error () (json-fail "Invalid JSON integer.")))))))
         (parse-array ()
           (expect #\[)
           (skip-whitespace)
           (when (and (peek) (char= (peek) #\]))
             (incf position)
             (return-from parse-array (%make-json-array '())))
           (let ((items '()))
             (loop
               (push (parse-value) items)
               (skip-whitespace)
               (cond
                 ((and (peek) (char= (peek) #\,))
                  (incf position)
                  (skip-whitespace))
                 ((and (peek) (char= (peek) #\]))
                  (incf position)
                  (return (%make-json-array (nreverse items))))
                 (t (json-fail "Expected a comma or closing bracket."))))))
         (parse-object ()
           (expect #\{)
           (skip-whitespace)
           (when (and (peek) (char= (peek) #\}))
             (incf position)
             (return-from parse-object (%make-json-object '())))
           (let ((entries '()))
             (loop
               (unless (and (peek) (char= (peek) #\"))
                 (json-fail "Expected an object key."))
               (let ((key (parse-string)))
                 (when (assoc key entries :test #'string=)
                   (json-fail "Duplicate JSON object key ~S." key))
                 (skip-whitespace)
                 (expect #\:)
                 (skip-whitespace)
                 (push (cons key (parse-value)) entries))
               (skip-whitespace)
               (cond
                 ((and (peek) (char= (peek) #\,))
                  (incf position)
                  (skip-whitespace))
                 ((and (peek) (char= (peek) #\}))
                  (incf position)
                  (return (%make-json-object (nreverse entries))))
                 (t (json-fail "Expected a comma or closing brace."))))))
         (parse-value ()
           (skip-whitespace)
           (case (peek)
             (#\" (parse-string))
             (#\{ (parse-object))
             (#\[ (parse-array))
             (#\t (parse-literal "true" :true))
             (#\f (parse-literal "false" :false))
             (#\n (parse-literal "null" :null))
             (otherwise
              (if (or (digit-p (peek))
                      (and (peek) (char= (peek) #\-)))
                  (parse-number)
                  (json-fail "Unexpected JSON value at character ~D." position))))))
      (let ((value (parse-value)))
        (skip-whitespace)
        (unless (= position length)
          (json-fail "Trailing data after JSON value."))
        value))))

(defun json-escape (text)
  (with-output-to-string (output)
    (loop for character across text
          do (case character
               (#\" (write-string "\\\"" output))
               (#\\ (write-string "\\\\" output))
               (#\Backspace (write-string "\\b" output))
               (#\Page (write-string "\\f" output))
               (#\Newline (write-string "\\n" output))
               (#\Return (write-string "\\r" output))
               (#\Tab (write-string "\\t" output))
               (otherwise
                (if (< (char-code character) 32)
                    (format output "\\u~4,'0X" (char-code character))
                    (write-char character output)))))))

(defun encode-json-float (value)
  (when (or (sb-ext:float-infinity-p value)
            (sb-ext:float-nan-p value))
    (json-fail "JSON cannot encode a non-finite number."))
  (let ((encoded (string-downcase (write-to-string value :readably t))))
    (substitute #\e #\d encoded)))

(defun json-encode (value)
  (labels ((emit (item output)
             (cond
               ((stringp item)
                (format output "\"~A\"" (json-escape item)))
               ((integerp item) (princ item output))
               ((floatp item) (write-string (encode-json-float item) output))
               ((eq item :true) (write-string "true" output))
               ((eq item :false) (write-string "false" output))
               ((eq item :null) (write-string "null" output))
               ((json-object-p item)
                (write-char #\{ output)
                (loop for (key . entry-value) in (json-object-entries item)
                      for first = t then nil
                      do (unless first (write-char #\, output))
                         (emit key output)
                         (write-char #\: output)
                         (emit entry-value output))
                (write-char #\} output))
               ((json-array-p item)
                (write-char #\[ output)
                (loop for entry in (json-array-items item)
                      for first = t then nil
                      do (unless first (write-char #\, output))
                         (emit entry output))
                (write-char #\] output))
               (t (json-fail "Cannot encode ~S as JSON." item)))))
    (with-output-to-string (output)
      (emit value output))))
