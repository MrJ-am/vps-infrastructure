(in-package #:vision)

(defun browser-enum (value name choices)
  (unless (member value choices :test #'equal)
    (invalid-parameters "Invalid ~A." name))
  value)

(defun browser-number (value name minimum maximum &key nullable)
  (unless (or (and nullable (eq value :null))
              (and (fsrs-finite-number-p value) (<= minimum value maximum)))
    (invalid-parameters "Invalid ~A." name))
  value)

(defun browser-timestamp (value name &key nullable)
  (unless (and nullable (eq value :null))
    (validated-string value name 64 :allow-empty nil)))

(defun browser-query (operation arguments actor)
  (ensure-object arguments "Request")
  (cond
    ((string= operation "list")
     (validate-object-keys arguments '("query" "tags" "tagMode" "state" "sort" "direction"
       "limit" "offset" "importance" "dueBefore" "dueAfter" "updatedAfter"
       "minStability" "maxDifficulty" "maxRetrievability"))
     (validated-string (required-value arguments "query") "query" 500)
     (normalized-string-array arguments "tags" 50 64 :downcase t)
     (browser-enum (required-value arguments "tagMode") "tagMode" '("all" "any"))
     (browser-enum (required-value arguments "state") "state" '("active" "all" "archived" "due" "new" "scheduled" "unscheduled"))
     (browser-enum (required-value arguments "sort") "sort" '("title" "dueAt" "createdAt" "updatedAt" "lastReviewedAt" "importance" "reviewCount" "fsrsStability" "fsrsDifficulty" "retrievability"))
     (browser-enum (required-value arguments "direction") "direction" '("asc" "desc"))
     (validated-integer (required-value arguments "limit") "limit" 1 100)
     (validated-integer (required-value arguments "offset") "offset" 0 100000000)
     (dolist (key '("dueBefore" "dueAfter" "updatedAfter"))
       (multiple-value-bind (value present) (json-object-get arguments key)
         (when present (browser-timestamp value key))))
     (dolist (spec '(("importance" 1 5) ("minStability" 0.001 36500) ("maxDifficulty" 1 10) ("maxRetrievability" 0 1)))
       (multiple-value-bind (value present) (json-object-get arguments (first spec))
         (when present (apply #'browser-number value spec)))))
    ((string= operation "get")
     (validate-object-keys arguments '("sheetId" "observationOffset"))
     (validated-integer (required-value arguments "sheetId") "sheetId" 1 most-positive-fixnum)
     (optional-integer arguments "observationOffset" 0 0 100000000))
    ((string= operation "save")
     (validate-object-keys arguments '("sheetId" "expectedUpdatedAt" "title" "body" "summary" "tags" "aliases" "importance" "dueAt" "fsrsStability" "fsrsDifficulty" "fsrsLastReviewedAt" "archived"))
     (multiple-value-bind (id present) (json-object-get arguments "sheetId")
       (when present
         (validated-integer id "sheetId" 1 most-positive-fixnum)
         (browser-timestamp (required-value arguments "expectedUpdatedAt") "expectedUpdatedAt")))
     (validated-string (required-value arguments "title") "title" 200 :allow-empty nil)
     (validated-string (required-value arguments "body") "body" 50000 :allow-empty nil)
     (validated-string (required-value arguments "summary") "summary" 2000)
     (normalized-string-array arguments "tags" 50 64 :downcase t)
     (normalized-string-array arguments "aliases" 50 120)
     (validated-integer (required-value arguments "importance") "importance" 1 5)
     (browser-timestamp (required-value arguments "dueAt") "dueAt" :nullable t)
     (browser-timestamp (required-value arguments "fsrsLastReviewedAt") "fsrsLastReviewedAt" :nullable t)
     (browser-number (required-value arguments "fsrsStability") "fsrsStability" 0.001 36500 :nullable t)
     (browser-number (required-value arguments "fsrsDifficulty") "fsrsDifficulty" 1 10 :nullable t)
     (browser-enum (required-value arguments "archived") "archived" '(:true :false)))
    ((string= operation "correct")
     (validate-object-keys arguments '("observationId" "expectedCorrectionId" "note" "context"))
     (validated-integer (required-value arguments "observationId") "observationId" 1 most-positive-fixnum)
     (validated-integer (required-value arguments "expectedCorrectionId") "expectedCorrectionId" 0 most-positive-fixnum)
     (validated-string (required-value arguments "note") "note" 4000 :allow-empty nil)
     (ensure-object (required-value arguments "context") "context"))
    (t (invalid-parameters "Unknown browser operation.")))
  (database-query-json
    (concatenate 'string "web_" operation)
    (cond ((string= operation "list") "SELECT vision_web_list(:'input'::jsonb)")
          ((string= operation "get") "SELECT COALESCE(vision_web_get(:'input'::jsonb), '{\"error\":\"not_found\"}'::jsonb)")
          ((string= operation "save") "SELECT vision_web_save(:'input'::jsonb, :'actor'::text)")
          (t "SELECT vision_web_correct(:'input'::jsonb, :'actor'::text)"))
    (list (cons "input" (json-encode arguments)) (cons "actor" actor))))

(defun handle-browser-request (stream path headers body)
  ;; Nginx verifies the shared session AND the CSRF token before adding this.
  (unless (equal (header-values "x-vision-browser" headers) '("1"))
    (write-json stream 401 "Unauthorized" "{\"error\":\"authentication_required\"}")
    (return-from handle-browser-request))
  (unless (json-content-type-p headers)
    (write-json stream 415 "Unsupported Media Type" "{\"error\":\"json_required\"}")
    (return-from handle-browser-request))
  (handler-case
      (let* ((result (browser-query (subseq path (length "/api/web/")) (parse-json body)
                                    (or (first (header-values "x-mrj-user" headers)) "browser")))
             (error-code (database-result-error result)))
        (cond ((equal error-code "conflict") (write-json stream 409 "Conflict" (json-encode result)))
              ((equal error-code "not_found") (write-json stream 404 "Not Found" (json-encode result)))
              (t (write-json stream 200 "OK" (json-encode result)))))
    (json-error () (write-json stream 400 "Bad Request" "{\"error\":\"invalid_json\"}"))
    (invalid-parameters (condition)
      (write-json stream 400 "Bad Request" (json-encode (jobject "error" "invalid_input" "message" (invalid-parameters-message condition)))))
    (database-error (condition)
      ;; SQL details may contain private text. Never return or log them.
      (declare (ignore condition))
      (write-json stream 400 "Bad Request" "{\"error\":\"invalid_data\",\"message\":\"Enregistrement impossible : vérifiez les valeurs et les dates.\"}"))))
